generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Stores user account information for all roles (customer, owner, staff, driver, admin)
model User {
  id                       String               @id @default(uuid())
  fullName                 String               @map("full_name") @db.VarChar(255)
  email                    String               @unique @db.VarChar(255)
  mobile                   String               @db.VarChar(20)
  passwordHash             String               @map("password_hash") @db.VarChar(255)
  profilePhoto             String?              @map("profile_photo") @db.Text
  isVerified               Boolean              @default(false) @map("is_verified")
  isActive                 Boolean              @default(true) @map("is_active")
  isDeleted                Boolean              @default(false) @map("is_deleted")
  deletedAt                DateTime?            @map("deleted_at")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  couponUsages             CouponUsage[]
  deliveryPartner          DeliveryPartner?
  loyaltyAccount           LoyaltyAccount?
  notifications            Notification[]
  orderStatusChanges       OrderStatusHistory[]
  orders                   Order[]
  savedPaymentMethods      SavedPaymentMethod[]
  refreshToken             RefreshToken[]
  refunds                  Refund[]
  staffAssignments         RestaurantStaff[]
  ownedRestaurants         Restaurant[]
  reviews                  Review[]
  supportTicketsAsAdmin    SupportTicket[]      @relation("TicketAdmin")
  supportTicketsAsCustomer SupportTicket[]      @relation("TicketCustomer")
  addresses                UserAddress[]
  userRoles                UserRole[]

  @@map("users")
}

/// Available roles on the platform (CUSTOMER, RESTAURANT_OWNER, RESTAURANT_STAFF, DELIVERY_PARTNER, ADMIN)
model Role {
  id        String     @id @default(uuid())
  role      String     @unique @db.VarChar(50)
  userRoles UserRole[]

  @@map("roles")
}

/// Junction table mapping users to their assigned roles (many-to-many)
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "user_roles_role_id_fkey")
  @@map("user_roles")
}

/// Customer saved delivery addresses
model UserAddress {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  label        String?   @db.VarChar(50)
  addressLine1 String?   @map("address_line1") @db.Text
  addressLine2 String?   @map("address_line2") @db.Text
  city         String?   @db.VarChar(100)
  state        String?   @db.VarChar(100)
  pincode      String?   @db.VarChar(20)
  latitude     Decimal?  @db.Decimal(10, 8)
  longitude    Decimal?  @db.Decimal(11, 8)
  isDefault    Boolean   @default(false) @map("is_default")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  orders       Order[]
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  token     String   @db.Text
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

/// Restaurant entity owned by a user
model Restaurant {
  id            String                @id @default(uuid())
  ownerId       String                @map("owner_id")
  name          String?               @db.VarChar(255)
  description   String?               @db.Text
  logoUrl       String?               @map("logo_url") @db.Text
  coverImageUrl String?               @map("cover_image_url") @db.Text
  isActive      Boolean               @default(true) @map("is_active")
  isDeleted     Boolean               @default(false) @map("is_deleted")
  deletedAt     DateTime?             @map("deleted_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  branches      RestaurantBranch[]
  promotions    RestaurantPromotion[]
  owner         User                  @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([name])
  @@map("restaurants")
}

/// Physical branch/location of a restaurant.
/// head_id references restaurant_staff to identify the branch head.
/// is_primary: Only ONE branch per restaurant should be marked primary — enforce in application logic
/// (MySQL does not support partial unique indexes).
model RestaurantBranch {
  id                 String             @id @default(uuid())
  restaurantId       String             @map("restaurant_id")
  headId             String?            @map("head_id")
  branchName         String?            @map("branch_name") @db.VarChar(255)
  addressLine1       String?            @map("address_line1") @db.Text
  addressLine2       String?            @map("address_line2") @db.Text
  city               String?            @db.VarChar(100)
  state              String?            @db.VarChar(100)
  pincode            String?            @db.VarChar(20)
  contactNumber      String?            @map("contact_number") @db.VarChar(20)
  gstin              String?            @db.VarChar(50)
  fssaiLicense       String?            @map("fssai_license") @db.VarChar(100)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  latitude           Decimal?           @db.Decimal(10, 8)
  longitude          Decimal?           @db.Decimal(11, 8)
  deliveryRadiusKm   Decimal?           @map("delivery_radius_km") @db.Decimal(5, 2)
  isPrimary          Boolean            @default(false) @map("is_primary")
  isActive           Boolean            @default(true) @map("is_active")
  isDeleted          Boolean            @default(false) @map("is_deleted")
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  categories         Category[]
  operatingHours     OperatingHour[]
  orders             Order[]
  head               RestaurantStaff?   @relation("BranchHead", fields: [headId], references: [id])
  restaurant         Restaurant         @relation(fields: [restaurantId], references: [id])
  staff              RestaurantStaff[]  @relation("BranchStaffMembers")
  reviews            Review[]

  @@index([restaurantId])
  @@index([headId])
  @@map("restaurant_branches")
}

/// Weekly operating schedule for a branch
model OperatingHour {
  id        String           @id @default(uuid())
  branchId  String           @map("branch_id")
  dayOfWeek DayOfWeek        @map("day_of_week")
  openTime  DateTime?        @map("open_time") @db.Time(0)
  closeTime DateTime?        @map("close_time") @db.Time(0)
  isClosed  Boolean          @default(false) @map("is_closed")
  isDeleted Boolean          @default(false) @map("is_deleted")
  deletedAt DateTime?        @map("deleted_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  branch    RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("operating_hours")
}

/// Maps users (staff) to the branches they work at.
/// Also referenced by RestaurantBranch.head_id to designate the branch head.
model RestaurantStaff {
  id                String             @id @default(uuid())
  userId            String             @map("user_id")
  branchId          String             @map("branch_id")
  isActive          Boolean            @default(true) @map("is_active")
  isDeleted         Boolean            @default(false) @map("is_deleted")
  deletedAt         DateTime?          @map("deleted_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  headOfBranches    RestaurantBranch[] @relation("BranchHead")
  restaurantPayouts RestaurantPayout[]
  branch            RestaurantBranch   @relation("BranchStaffMembers", fields: [branchId], references: [id])
  user              User               @relation(fields: [userId], references: [id])

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("restaurant_staff")
}

/// Menu category within a branch (e.g., Starters, Main Course, Beverages)
model Category {
  id           String           @id @default(uuid())
  branchId     String           @map("branch_id")
  name         String?          @db.VarChar(100)
  displayOrder Int              @default(0) @map("display_order")
  isDeleted    Boolean          @default(false) @map("is_deleted")
  deletedAt    DateTime?        @map("deleted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  branch       RestaurantBranch @relation(fields: [branchId], references: [id])
  menuItems    MenuItem[]

  @@index([branchId])
  @@map("categories")
}

/// Individual food item on the menu
model MenuItem {
  id                 String              @id @default(uuid())
  branchId           String              @map("branch_id")
  categoryId         String              @map("category_id")
  name               String?             @db.VarChar(255)
  description        String?             @db.Text
  price              Decimal?            @db.Decimal(10, 2)
  isVeg              Boolean             @default(true) @map("is_veg")
  imageUrl           String?             @map("image_url") @db.Text
  isAvailable        Boolean             @default(true) @map("is_available")
  isBestseller       Boolean             @default(false) @map("is_bestseller")
  isDeleted          Boolean             @default(false) @map("is_deleted")
  deletedAt          DateTime?           @map("deleted_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  tags               MenuItemTag[]
  category           Category            @relation(fields: [categoryId], references: [id])
  modifierGroups     ModifierGroup[]
  orderItems         OrderItem[]
  promotionMenuItems PromotionMenuItem[]

  @@index([categoryId])
  @@index([name])
  @@index([branchId], map: "menu_items_branch_id_fkey")
  @@map("menu_items")
}

/// Dietary / allergen tags (Vegan, Gluten-Free, Jain, Halal, etc.)
model DietaryTag {
  id           String        @id @default(uuid())
  name         String        @db.VarChar(50)
  menuItemTags MenuItemTag[]

  @@map("dietary_tags")
}

/// Junction table: many-to-many between menu items and dietary tags
model MenuItemTag {
  id         String     @id @default(uuid())
  menuItemId String     @map("menu_item_id")
  tagId      String     @map("tag_id")
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  dietaryTag DietaryTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, tagId])
  @@index([menuItemId])
  @@index([tagId])
  @@map("menu_item_tags")
}

/// Customization group for a menu item (e.g., "Choose Size", "Extra Toppings")
model ModifierGroup {
  id           String           @id @default(uuid())
  menuItemId   String           @map("menu_item_id")
  name         String           @db.VarChar(100)
  minSelection Int              @default(0) @map("min_selection")
  maxSelection Int              @default(1) @map("max_selection")
  isRequired   Boolean          @default(false) @map("is_required")
  isDeleted    Boolean          @default(false) @map("is_deleted")
  deletedAt    DateTime?        @map("deleted_at")
  menuItem     MenuItem         @relation(fields: [menuItemId], references: [id])
  options      ModifierOption[]

  @@index([menuItemId])
  @@map("modifier_groups")
}

/// Individual option within a modifier group (e.g., "Large +₹50", "Extra Cheese +₹30")
model ModifierOption {
  id              String        @id @default(uuid())
  modifierGroupId String        @map("modifier_group_id")
  name            String        @db.VarChar(100)
  extraPrice      Decimal       @default(0.00) @map("extra_price") @db.Decimal(10, 2)
  isDeleted       Boolean       @default(false) @map("is_deleted")
  deletedAt       DateTime?     @map("deleted_at")
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@index([modifierGroupId])
  @@map("modifier_options")
}

/// Platform-wide discount coupons
model Coupon {
  id             String        @id @default(uuid())
  code           String        @unique @db.VarChar(50)
  type           CouponType
  discountValue  Decimal?      @map("discount_value") @db.Decimal(10, 2)
  minOrderAmount Decimal?      @map("min_order_amount") @db.Decimal(10, 2)
  maxDiscount    Decimal?      @map("max_discount") @db.Decimal(10, 2)
  startDate      DateTime?     @map("start_date")
  endDate        DateTime?     @map("end_date")
  usageLimit     Int?          @map("usage_limit")
  isActive       Boolean       @default(true) @map("is_active")
  isDeleted      Boolean       @default(false) @map("is_deleted")
  deletedAt      DateTime?     @map("deleted_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  couponUsages   CouponUsage[]
  orders         Order[]

  @@index([code])
  @@index([type])
  @@index([startDate])
  @@index([endDate])
  @@map("coupons")
}

/// Tracks coupon redemption history (never delete — audit trail)
model CouponUsage {
  id         String    @id @default(uuid())
  couponId   String    @map("coupon_id")
  customerId String    @map("customer_id")
  orderId    String    @map("order_id")
  usedAt     DateTime? @map("used_at")
  coupon     Coupon    @relation(fields: [couponId], references: [id])
  customer   User      @relation(fields: [customerId], references: [id])
  order      Order     @relation(fields: [orderId], references: [id])

  @@index([couponId])
  @@index([customerId])
  @@index([orderId])
  @@map("coupon_usages")
}

model RestaurantPromotion {
  id                    String              @id @default(uuid())
  restaurantId          String              @map("restaurant_id")
  title                 String              @db.VarChar(255)
  type                  PromotionType
  discountValue         Decimal?            @map("discount_value") @db.Decimal(10, 2)
  startDate             DateTime            @map("start_date") @db.Date
  endDate               DateTime            @map("end_date") @db.Date
  code                  String?             @db.VarChar(50)
  deletedAt             DateTime?
  isActive              Boolean             @default(true)
  isDeleted             Boolean             @default(false)
  maximumDiscountAmount Decimal?            @map("maximum_discount_amount") @db.Decimal(10, 2)
  minimumOrderAmount    Decimal?            @map("minimum_order_amount") @db.Decimal(10, 2)
  promotionMenuItems    PromotionMenuItem[]
  restaurant            Restaurant          @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("restaurant_promotions")
}

model PromotionMenuItem {
  id          String              @id @default(uuid())
  promotionId String              @map("promotion_id")
  menuItemId  String              @map("menu_item_id")
  menuItem    MenuItem            @relation(fields: [menuItemId], references: [id])
  promotion   RestaurantPromotion @relation(fields: [promotionId], references: [id])

  @@unique([promotionId, menuItemId])
  @@index([menuItemId], map: "promotion_menu_items_menu_item_id_fkey")
  @@map("promotion_menu_items")
}

/// Tracks current loyalty points balance for a customer (never delete)
model LoyaltyAccount {
  id            String               @id @default(uuid())
  customerId    String               @unique @map("customer_id")
  currentPoints Int                  @default(0) @map("current_points")
  customer      User                 @relation(fields: [customerId], references: [id])
  transactions  LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

/// Immutable history of loyalty point earn/redeem transactions (never delete)
model LoyaltyTransaction {
  id               String                 @id @default(uuid())
  accountId        String                 @map("account_id")
  points           Int
  transactionType  LoyaltyTransactionType @map("transaction_type")
  referenceOrderId String?                @map("reference_order_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  account          LoyaltyAccount         @relation(fields: [accountId], references: [id])
  referenceOrder   Order?                 @relation(fields: [referenceOrderId], references: [id])

  @@index([accountId])
  @@index([referenceOrderId])
  @@map("loyalty_transactions")
}

/// Main order entity (never delete — audit trail)
model Order {
  id                  String               @id @default(uuid())
  orderNumber         String               @unique @map("order_number") @db.VarChar(50)
  customerId          String               @map("customer_id")
  branchId            String               @map("branch_id")
  addressId           String               @map("address_id")
  couponId            String?              @map("coupon_id")
  subtotal            Decimal              @db.Decimal(10, 2)
  taxAmount           Decimal              @map("tax_amount") @db.Decimal(10, 2)
  deliveryFee         Decimal              @map("delivery_fee") @db.Decimal(10, 2)
  discountAmount      Decimal              @map("discount_amount") @db.Decimal(10, 2)
  totalAmount         Decimal              @map("total_amount") @db.Decimal(10, 2)
  status              OrderStatus
  paymentStatus       OrderPaymentStatus   @map("payment_status")
  scheduledAt         DateTime?            @map("scheduled_at")
  placedAt            DateTime             @map("placed_at")
  deliveredAt         DateTime?            @map("delivered_at")
  couponUsages        CouponUsage[]
  delivery            Delivery?
  loyaltyTransactions LoyaltyTransaction[]
  orderItems          OrderItem[]
  statusHistory       OrderStatusHistory[]
  address             UserAddress          @relation(fields: [addressId], references: [id])
  branch              RestaurantBranch     @relation(fields: [branchId], references: [id])
  coupon              Coupon?              @relation(fields: [couponId], references: [id])
  customer            User                 @relation(fields: [customerId], references: [id])
  payments            Payment[]
  payoutTransaction   PayoutTransaction?
  review              Review?
  supportTickets      SupportTicket[]

  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
  @@index([customerId, status])
  @@index([addressId], map: "orders_address_id_fkey")
  @@index([couponId], map: "orders_coupon_id_fkey")
  @@map("orders")
}

/// Line item within an order — snapshots menu item name and price at time of ordering (never delete)
model OrderItem {
  id                 String              @id @default(uuid())
  orderId            String              @map("order_id")
  menuItemId         String?             @map("menu_item_id")
  menuItemName       String              @map("menu_item_name") @db.VarChar(255)
  price              Decimal             @db.Decimal(10, 2)
  quantity           Int
  specialInstruction String?             @map("special_instruction") @db.Text
  modifiers          OrderItemModifier[]
  menuItem           MenuItem?           @relation(fields: [menuItemId], references: [id])
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

/// Modifier options selected for an order item — snapshots name and price (never delete)
model OrderItemModifier {
  id           String    @id @default(uuid())
  orderItemId  String    @map("order_item_id")
  modifierName String    @map("modifier_name") @db.VarChar(255)
  extraPrice   Decimal   @map("extra_price") @db.Decimal(10, 2)
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

/// Immutable audit trail of every order status transition (never delete)
model OrderStatusHistory {
  id        String    @id @default(uuid())
  orderId   String    @map("order_id")
  oldStatus String?   @map("old_status") @db.VarChar(50)
  newStatus String?   @map("new_status") @db.VarChar(50)
  changedBy String?   @map("changed_by")
  changedAt DateTime? @map("changed_at")
  user      User?     @relation(fields: [changedBy], references: [id])
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([changedBy])
  @@map("order_status_history")
}

/// Delivery partner profile linked to a user account
model DeliveryPartner {
  id                     String                  @id @default(uuid())
  userId                 String                  @unique @map("user_id")
  vehicleType            VehicleType             @map("vehicle_type")
  vehicleNumber          String                  @unique @map("vehicle_number") @db.VarChar(30)
  governmentId           String                  @map("government_id") @db.VarChar(100)
  status                 DeliveryPartnerStatus   @default(PENDING_VERIFICATION)
  isDeleted              Boolean                 @default(false) @map("is_deleted")
  deletedAt              DateTime?               @map("deleted_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  deliveries             Delivery[]              @relation("CurrentPartner")
  assignments            DeliveryAssignment[]
  deliveryPartnerPayouts DeliveryPartnerPayout[]
  user                   User                    @relation(fields: [userId], references: [id])
  reviews                Review[]

  @@index([userId])
  @@index([vehicleNumber])
  @@index([status])
  @@map("delivery_partners")
}

/// Main delivery record for an order (never delete)
model Delivery {
  id               String               @id @default(uuid())
  orderId          String               @unique @map("order_id")
  currentPartnerId String?              @map("current_partner_id")
  status           DeliveryStatus       @default(PENDING)
  acceptedAt       DateTime?            @map("accepted_at")
  pickedUpAt       DateTime?            @map("picked_up_at")
  deliveredAt      DateTime?            @map("delivered_at")
  currentPartner   DeliveryPartner?     @relation("CurrentPartner", fields: [currentPartnerId], references: [id])
  order            Order                @relation(fields: [orderId], references: [id])
  assignments      DeliveryAssignment[]

  @@index([currentPartnerId])
  @@map("deliveries")
}

/// Assignment history — tracks every driver assignment attempt (never delete)
model DeliveryAssignment {
  id             String              @id @default(uuid())
  deliveryId     String              @map("delivery_id")
  partnerId      String              @map("partner_id")
  assignedAt     DateTime            @map("assigned_at")
  respondedAt    DateTime?           @map("responded_at")
  responseStatus AssignmentResponse? @map("response_status")
  delivery       Delivery            @relation(fields: [deliveryId], references: [id])
  partner        DeliveryPartner     @relation(fields: [partnerId], references: [id])

  @@index([deliveryId])
  @@index([partnerId])
  @@map("delivery_assignments")
}

/// Payment transaction record for an order (never delete — audit trail)
model Payment {
  id                   String                   @id @default(uuid())
  orderId              String                   @map("order_id")
  paymentMethod        PaymentMethodType        @map("payment_method")
  gateway              String?                  @db.VarChar(100)
  gatewayTransactionId String?                  @map("gateway_transaction_id") @db.VarChar(255)
  amount               Decimal                  @db.Decimal(10, 2)
  status               PaymentTransactionStatus @default(PENDING)
  paidAt               DateTime?                @map("paid_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  order                Order                    @relation(fields: [orderId], references: [id])
  refunds              Refund[]

  @@index([orderId])
  @@index([paymentMethod])
  @@index([status])
  @@index([gatewayTransactionId])
  @@map("payments")
}

/// Saved / tokenized payment instruments for returning customers
model SavedPaymentMethod {
  id          String    @id @default(uuid())
  customerId  String    @map("customer_id")
  methodType  String?   @map("method_type") @db.VarChar(30)
  provider    String?   @db.VarChar(50)
  token       String?   @db.VarChar(255)
  displayName String?   @map("display_name") @db.VarChar(100)
  isDefault   Boolean   @default(false) @map("is_default")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  customer    User      @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("payment_methods")
}

/// Refund request and lifecycle tracking (never delete — audit trail)
model Refund {
  id              String       @id @default(uuid())
  paymentId       String       @map("payment_id")
  userId          String       @map("user_id")
  amount          Decimal      @db.Decimal(10, 2)
  reason          String       @db.Text
  refundType      RefundType   @map("refund_type")
  status          RefundStatus @default(REQUESTED)
  gatewayRefundId String?      @map("gateway_refund_id") @db.VarChar(255)
  requestedAt     DateTime?    @map("requested_at")
  processedAt     DateTime?    @map("processed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  payment         Payment      @relation(fields: [paymentId], references: [id])
  user            User         @relation(fields: [userId], references: [id])

  @@index([paymentId])
  @@index([userId])
  @@index([status])
  @@map("refunds")
}

/// Customer review after order delivery (one review per order)
model Review {
  id                String           @id @default(uuid())
  orderId           String           @unique @map("order_id")
  userId            String           @map("user_id")
  branchId          String           @map("branch_id")
  deliveryPartnerId String?          @map("delivery_partner_id")
  foodRating        Int?             @map("food_rating")
  deliveryRating    Int?             @map("delivery_rating")
  packagingRating   Int?             @map("packaging_rating")
  reviewText        String?          @map("review_text") @db.Text
  isDeleted         Boolean          @default(false) @map("is_deleted")
  deletedAt         DateTime?        @map("deleted_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  images            ReviewImage[]
  branch            RestaurantBranch @relation(fields: [branchId], references: [id])
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  order             Order            @relation(fields: [orderId], references: [id])
  user              User             @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([branchId])
  @@index([createdAt])
  @@index([deliveryPartnerId], map: "reviews_delivery_partner_id_fkey")
  @@map("reviews")
}

/// Images attached to a review (hard delete allowed)
model ReviewImage {
  id       String @id @default(uuid())
  reviewId String @map("review_id")
  imageUrl String @map("image_url") @db.VarChar(255)
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

/// Customer support tickets
model SupportTicket {
  id            String             @id @default(uuid())
  orderId       String?            @map("order_id")
  customerId    String             @map("customer_id")
  assignedAdmin String?            @map("assigned_admin")
  issueType     IssueType          @map("issue_type")
  description   String?            @db.Text
  status        TicketStatus       @default(OPEN)
  isDeleted     Boolean            @default(false) @map("is_deleted")
  deletedAt     DateTime?          @map("deleted_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  resolvedAt    DateTime?          @map("resolved_at")
  admin         User?              @relation("TicketAdmin", fields: [assignedAdmin], references: [id])
  customer      User               @relation("TicketCustomer", fields: [customerId], references: [id])
  order         Order?             @relation(fields: [orderId], references: [id])
  attachments   TicketAttachment[]

  @@index([orderId])
  @@index([customerId])
  @@index([assignedAdmin])
  @@index([status])
  @@map("support_tickets")
}

/// File attachments for support tickets (hard delete)
model TicketAttachment {
  id       String        @id @default(uuid())
  ticketId String        @map("ticket_id")
  fileUrl  String        @map("file_url") @db.VarChar(255)
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_attachments")
}

/// In-app user notifications (tracks delivery and read status)
model Notification {
  id               String                     @id @default(uuid())
  userId           String                     @map("user_id")
  title            String                     @db.VarChar(255)
  message          String                     @db.Text
  notificationType NotificationType           @map("notification_type")
  status           NotificationDeliveryStatus @default(PENDING)
  sentAt           DateTime?                  @map("sent_at")
  readAt           DateTime?                  @map("read_at")
  isDeleted        Boolean                    @default(false) @map("is_deleted")
  deletedAt        DateTime?                  @map("deleted_at")
  user             User                       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([notificationType])
  @@map("notifications")
}

model PayoutTransaction {
  id                String                  @id @default(uuid())
  orderId           String                  @unique @map("order_id")
  grossAmount       Decimal                 @map("gross_amount") @db.Decimal(10, 2)
  branchAmount      Decimal                 @map("branch_amount") @db.Decimal(10, 2)
  deliveryAmount    Decimal                 @map("delivery_amount") @db.Decimal(10, 2)
  platformFee       Decimal                 @map("platform_fee") @db.Decimal(10, 2)
  status            PayoutStatus            @default(COMPLETED)
  processedAt       DateTime?               @map("processed_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  deliveryPayouts   DeliveryPartnerPayout[]
  order             Order                   @relation(fields: [orderId], references: [id])
  restaurantPayouts RestaurantPayout[]

  @@index([orderId])
  @@map("payout_transactions")
}

model RestaurantPayout {
  id                  String            @id @default(uuid())
  payoutTransactionId String            @map("payout_transaction_id")
  branchHeadId        String            @map("branch_head_id")
  amount              Decimal           @db.Decimal(10, 2)
  status              SettlementStatus  @default(PENDING)
  settlementId        String?           @map("settlement_id")
  transferredAt       DateTime?         @map("transferred_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  branchHead          RestaurantStaff   @relation(fields: [branchHeadId], references: [id])
  payoutTransaction   PayoutTransaction @relation(fields: [payoutTransactionId], references: [id])
  settlement          Settlement?       @relation(fields: [settlementId], references: [id])

  @@index([branchHeadId])
  @@index([status])
  @@index([settlementId])
  @@index([payoutTransactionId], map: "restaurant_payouts_payout_transaction_id_fkey")
  @@map("restaurant_payouts")
}

model DeliveryPartnerPayout {
  id                  String            @id @default(uuid())
  payoutTransactionId String            @map("payout_transaction_id")
  deliveryPartnerId   String            @map("delivery_partner_id")
  amount              Decimal           @db.Decimal(10, 2)
  status              SettlementStatus  @default(PENDING)
  settlementId        String?           @map("settlement_id")
  transferredAt       DateTime?         @map("transferred_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  deliveryPartner     DeliveryPartner   @relation(fields: [deliveryPartnerId], references: [id])
  payoutTransaction   PayoutTransaction @relation(fields: [payoutTransactionId], references: [id])
  settlement          Settlement?       @relation(fields: [settlementId], references: [id])

  @@index([deliveryPartnerId])
  @@index([status])
  @@index([settlementId])
  @@index([payoutTransactionId], map: "delivery_partner_payouts_payout_transaction_id_fkey")
  @@map("delivery_partner_payouts")
}

model Settlement {
  id                String                  @id @default(uuid())
  settlementType    SettlementType          @map("settlement_type")
  beneficiaryId     String                  @map("beneficiary_id")
  totalAmount       Decimal                 @map("total_amount") @db.Decimal(10, 2)
  payoutCount       Int                     @default(0) @map("payout_count")
  status            SettlementStatus        @default(PENDING)
  settledAt         DateTime?               @map("settled_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  deliveryPayouts   DeliveryPartnerPayout[]
  restaurantPayouts RestaurantPayout[]

  @@index([beneficiaryId])
  @@index([status])
  @@map("settlements")
}

