generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// user module

model User {
  id String @id @default(uuid()) @db.VarChar(36)

  fullName String @map("full_name") @db.VarChar(255)
  email    String @unique @db.VarChar(255)
  mobile   String @unique @db.VarChar(20)

  passwordHash String  @map("password_hash") @db.VarChar(255)
  profilePhoto String? @map("profile_photo")

  isVerified Boolean @default(false) @map("is_verified")
  isActive   Boolean @default(true) @map("is_active")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  userRoles        UserRole[]
  userAddresses    UserAddress[]
  ownedRestaurants Restaurant[]       @relation("RestaurantOwner")
  ownedBranches    RestaurantBranch[] @relation("BranchOwner")
  restaurantStaff  RestaurantStaff[]

  @@map("users")
}

// predefined roles
enum RoleType {
  CUSTOMER
  RESTAURANT_OWNER
  RESTAURANT_STAFF
  DELIVERY_PARTNER
  ADMIN
  FLEET_MANAGER
}

model Role {
  id String @id @default(uuid()) @db.VarChar(36)

  role RoleType @unique

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.VarChar(36)
  roleId String @map("role_id") @db.VarChar(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

//address module

model UserAddress {
  id String @id @default(uuid()) @db.VarChar(36)

  userId String @map("user_id") @db.VarChar(36)

  label        String? @db.VarChar(50)
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")

  city    String? @db.VarChar(100)
  state   String? @db.VarChar(100)
  pincode String? @db.VarChar(20)

  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  isDefault Boolean? @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

//restaurant module

model Restaurant {
  id String @id @default(uuid()) @db.VarChar(36)

  ownerId String @map("owner_id") @db.VarChar(36)

  name          String? @db.VarChar(255)
  description   String?
  logoUrl       String? @map("logo_url")
  coverImageUrl String? @map("cover_image_url")
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  owner User @relation("RestaurantOwner", fields: [ownerId], references: [id])

  branches RestaurantBranch[]

  @@index([name])
  @@index([ownerId])
  @@map("restaurants")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

//restaurant branches
model RestaurantBranch {
  id String @id @default(uuid()) @db.VarChar(36)

  restaurantId String @map("restaurant_id") @db.VarChar(36)

  //it will be the owner of the branch, can be same as restaurant owner or different staff member
  ownerId String @map("owner_id") @db.VarChar(36)

  branchName String? @map("branch_name") @db.VarChar(255)

  // Contact
  contactNumber String? @map("contact_number") @db.VarChar(20)

  // Address
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")

  city    String? @db.VarChar(100)
  state   String? @db.VarChar(100)
  pincode String? @db.VarChar(20)

  gstin        String? @db.VarChar(50)
  fssaiLicense String? @map("fssai_license") @db.VarChar(100)

  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")

  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  deliveryRadiusKm Decimal? @map("delivery_radius_km") @db.Decimal(10, 2)

  //head branch or main restaurant
  isPrimary Boolean @default(false) @map("is_primary")

  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  owner      User       @relation("BranchOwner", fields: [ownerId], references: [id])

  operatingHours OperatingHour[]
  staff          RestaurantStaff[]

  @@index([restaurantId])
  @@index([city])
  @@index([state])
  @@index([pincode])
  @@map("restaurant_branches")
}

//operating hours for restaurant branches
enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

//operating hours for restaurant branches
model OperatingHour {
  id String @id @default(uuid()) @db.VarChar(36)

  branchId String @map("branch_id") @db.VarChar(36)

  dayOfWeek DayOfWeek @map("day_of_week")

  openTime  DateTime? @map("open_time") @db.Time(0)
  closeTime DateTime? @map("close_time") @db.Time(0)

  isClosed Boolean @default(false) @map("is_closed")

  // Relations
  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
  @@map("operating_hours")
}

//restaurant staff 
model RestaurantStaff {
  id String @id @default(uuid()) @db.VarChar(36)

  userId   String @map("user_id") @db.VarChar(36)
  branchId String @map("branch_id") @db.VarChar(36)

  isActive  Boolean @default(true) @map("is_active")
  isDeleted Boolean @default(false) @map("is_deleted")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("restaurant_staff")
}
