<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restaurant Login</title>

    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/common/toast.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body>
    <div id="toast"></div>
    <div class="container">

        <!-- LEFT PANEL -->

        <div class="left-panel">

            <div class="brand">Ziggy</div>

            <div class="content">

                <h1>
                    Grow Your Restaurant With Us
                </h1>

                <p>
                    Manage orders, track revenue and reach
                    thousands of hungry customers every day.
                </p>

            </div>

            <img src="/images/restaurant-login.png" alt="Restaurant" class="burger">

            <div class="wave">〰</div>

        </div>

        <!-- RIGHT PANEL -->

        <div class="right-panel">

            <div class="form-wrapper">

                <h2>Restaurant Login</h2>

                <span>
                    Access your restaurant dashboard
                </span>

                <form id="loginForm">

                    <div class="input-group">

                        <label>Email Address</label>

                        <div class="input-box">

                            <i class="fa-regular fa-envelope"></i>

                            <input type="email" name="email" placeholder="Enter restaurant email" required>

                        </div>

                    </div>

                    <div class="input-group">

                        <label>Password</label>

                        <div class="input-box">

                            <i class="fa-solid fa-lock"></i>

                            <input type="password" id="password" name="password" placeholder="Enter password" required>

                            <i class="fa-regular fa-eye toggle" onclick="togglePassword()"></i>

                        </div>

                    </div>

                    <div class="terms">

                        <input type="checkbox" name="rememberMe">

                        <p>
                            Remember Me
                        </p>

                    </div>


                    <div class="forgot-password">


                        <a href="/api/auth/forget-password">
                            Forgot Password?
                        </a>

                    </div>

                    <button type="submit" class="signup-btn">
                        Login
                    </button>

                </form>

                <div class="login-link">

                    New Restaurant Partner?

                    <a href="/api/auth/restaurant_owner/static/register">
                        Register Now
                    </a>

                </div>

            </div>

        </div>

    </div>
    <script>const role = "<%= role %>";</script>
    <script src="/js/common/togglePassword.js"></script>
    <script src="/js/common/toast.js"></script>
    <script src="/js/login.js"></script>
</body>

</html>