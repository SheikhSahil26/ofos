<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Ziggy - Choose Role</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }
    </style>
</head>

<body class="bg-[#FFF8F3] min-h-screen">

    <!-- Background Decoration -->

    <div class="fixed inset-0 overflow-hidden pointer-events-none">

        <div class="absolute top-16 left-10 text-8xl opacity-5">
            🍔
        </div>

        <div class="absolute top-28 right-20 text-7xl opacity-5">
            🍕
        </div>

        <div class="absolute bottom-16 left-20 text-8xl opacity-5">
            🍟
        </div>

        <div class="absolute bottom-28 right-24 text-7xl opacity-5">
            🌮
        </div>

    </div>

    <!-- Header -->

    <header class="max-w-7xl mx-auto px-6 pt-8">


        <div class="text-center">

            <h1 class="
        text-5xl
        font-extrabold
        text-orange-500
        tracking-tight">

                Ziggy

            </h1>

        </div>

        <div class="text-center mt-8">

            <p class="
                uppercase
                tracking-[5px]
                text-xs
                font-semibold
                text-gray-500">

                Choose Your Role

            </p>

            <h1 class="
                mt-4
                text-3xl
                md:text-5xl
                font-bold
                text-gray-800">

                Login or Sign Up to

                <span class="text-orange-500">
                    Get Started
                </span>

            </h1>

            <p class="
                mt-4
                text-gray-500
                text-sm
                md:text-base">

                Select how you want to continue with Ziggy

            </p>

        </div>

    </header>

    <!-- Role Cards -->

    <section class="
        max-w-[1600px]
        mx-auto
        px-6
        py-16
        grid
        grid-cols-1
        md:grid-cols-2
        xl:grid-cols-4
        gap-8">

        <!-- CUSTOMER -->

        <div class="
            bg-white
            rounded-[32px]
            h-[420px]
            shadow-lg
            hover:shadow-2xl
            hover:-translate-y-3
            transition-all
            duration-300
            flex
            flex-col
            justify-center
            items-center
            text-center
            p-10">

            <div class="
                w-24
                h-24
                rounded-full
                bg-orange-100
                flex
                justify-center
                items-center
                text-5xl">

                👤

            </div>

            <h2 class="
                mt-6
                text-2xl
                font-bold
                text-gray-800">

                Customer

            </h2>

            <p class="
                mt-4
                text-gray-500
                leading-relaxed">

                Order your favourite food and enjoy
                fast doorstep delivery.

            </p>

            <button data-role="customer" class="
                role-btn
                mt-8
                bg-green-900
                hover:bg-green-800
                text-white
                px-10
                py-4
                rounded-xl
                font-semibold
                text-lg">

                Login / Sign Up

            </button>

        </div>

        <!-- RESTAURANT -->

        <div class="
            bg-white
            rounded-[32px]
            h-[420px]
            shadow-lg
            hover:shadow-2xl
            hover:-translate-y-3
            transition-all
            duration-300
            flex
            flex-col
            justify-center
            items-center
            text-center
            p-10">

            <div class="
                w-24
                h-24
                rounded-full
                bg-green-100
                flex
                justify-center
                items-center
                text-5xl">

                🏪

            </div>

            <h2 class="
                mt-6
                text-2xl
                font-bold
                text-gray-800">

                Restaurant Partner

            </h2>

            <p class="
                mt-4
                text-gray-500
                leading-relaxed">

                Manage menu, orders and grow
                your restaurant business.

            </p>

            <button data-role="restaurant_owner" class="
                role-btn
                mt-8
                bg-green-900
                hover:bg-green-800
                text-white
                px-10
                py-4
                rounded-xl
                font-semibold
                text-lg">

                Login / Sign Up

            </button>

        </div>

        <!-- DELIVERY -->

        <div class="
            bg-white
            rounded-[32px]
            h-[420px]
            shadow-lg
            hover:shadow-2xl
            hover:-translate-y-3
            transition-all
            duration-300
            flex
            flex-col
            justify-center
            items-center
            text-center
            p-10">

            <div class="
                w-24
                h-24
                rounded-full
                bg-orange-100
                flex
                justify-center
                items-center
                text-5xl">

                🛵

            </div>

            <h2 class="
                mt-6
                text-2xl
                font-bold
                text-gray-800">

                Delivery Partner

            </h2>

            <p class="
                mt-4
                text-gray-500
                leading-relaxed">

                Deliver orders, earn more
                and work flexibly.

            </p>

            <button data-role="delivery_partner" class="
                role-btn
                mt-8
                bg-green-900
                hover:bg-green-800
                text-white
                px-10
                py-4
                rounded-xl
                font-semibold
                text-lg">

                Login / Sign Up

            </button>

        </div>

        <!-- FLEET -->

        <div class="
            bg-white
            rounded-[32px]
            h-[420px]
            shadow-lg
            hover:shadow-2xl
            hover:-translate-y-3
            transition-all
            duration-300
            flex
            flex-col
            justify-center
            items-center
            text-center
            p-10">

            <div class="
                w-24
                h-24
                rounded-full
                bg-green-100
                flex
                justify-center
                items-center
                text-5xl">

                👥

            </div>

            <h2 class="
                mt-6
                text-2xl
                font-bold
                text-gray-800">

                Fleet Manager

            </h2>

            <p class="
                mt-4
                text-gray-500
                leading-relaxed">

                Manage delivery teams and
                monitor operations.

            </p>

            <button data-role="fleet_manager" class="
                role-btn
                mt-8
                bg-green-900
                hover:bg-green-800
                text-white
                px-10
                py-4
                rounded-xl
                font-semibold
                text-lg">

                Login / Sign Up

            </button>

        </div>

    </section>

    <script>

        document
            .querySelectorAll(".role-btn")
            .forEach(button => {

                button.addEventListener(
                    "click",
                    () => {

                        const role =
                            button.dataset.role;

                        window.location.href = `http://localhost:8080/${role}/login`;

                    }
                );

            });

    </script>

</body>

</html>