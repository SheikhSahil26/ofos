<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ziggy Admin Login</title>

    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/common/toast.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body>

    <div id="toast"></div>

    <div class="container">

        <!-- LEFT PANEL -->

        <div class="left-panel">

            <div class="brand">
                Ziggy Admin
            </div>

            <div class="content">

                <h1>
                    Admin Portal
                </h1>

                <p>
                    Access the Ziggy administration panel to manage
                    restaurants, customers, orders, deliveries,
                    payouts and platform operations.
                </p>

            </div>

            <img src="/images/admin-dashboard.png" alt="Admin Dashboard" class="burger">

            <div class="wave">
                〰
            </div>

        </div>

        <!-- RIGHT PANEL -->

        <div class="right-panel">

            <div class="form-wrapper">

                <h2>
                    Admin Login
                </h2>

                <span>
                    Sign in with your administrator credentials
                </span>

                <form id="loginForm">

                    <!-- EMAIL -->

                    <div class="input-group">

                        <label>
                            Admin Email
                        </label>

                        <div class="input-box">

                            <i class="fa-regular fa-envelope"></i>

                            <input type="email" name="email" placeholder="Enter admin email" required>

                        </div>

                    </div>

                    <!-- PASSWORD -->

                    <div class="input-group">

                        <label>
                            Password
                        </label>

                        <div class="input-box">

                            <i class="fa-solid fa-lock"></i>

                            <input type="password" id="password" name="password" placeholder="Enter your password"
                                required>

                            <i class="fa-regular fa-eye toggle" onclick="togglePassword()">
                            </i>

                        </div>

                    </div>
                    <div class="terms">

                        <input type="checkbox" name="rememberMe">

                        <p>
                            Remember Me
                        </p>

                    </div>



                    <!-- SECURITY NOTICE -->

                    <div style="
                        margin-top:18px;
                        padding:12px;
                        background:#f8f9fa;
                        border-left:4px solid #ff7a00;
                        border-radius:8px;
                    ">

                        <small style="
                            color:#666;
                            line-height:22px;
                        ">

                            Authorized administrators only.
                            All login activities are monitored
                            and recorded for security purposes.

                        </small>

                    </div>

                    <!-- FORGOT PASSWORD -->

                    <div style="
                        display:flex;
                        justify-content:flex-end;
                        margin-top:14px;
                    ">

                        <a href="http://localhost:8080/forget-password" style="
                            color:#777;
                            text-decoration:none;
                        ">

                            Forgot Password?

                        </a>

                    </div>

                    <!-- LOGIN BUTTON -->

                    <input type="submit" class="signup-btn" value="Admin Login" id="loginBtn">

                </form>

                <!-- SUPPORT -->

                <div class="login-link">

                    Need help accessing the admin panel?

                    <a href="/support">
                        Contact Support
                    </a>

                </div>

            </div>

        </div>

    </div>

    <script>
        const role = "ADMIN";
    </script>

    <script src="/js/common/togglePassword.js"></script>
    <script src="/js/common/toast.js"></script>
    <script src="/js/login.js"></script>

</body>

</html>