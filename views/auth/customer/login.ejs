<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Login</title>

    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/common/toast.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body>
    <div id="toast"></div>
    <div class="container">

        <!-- LEFT SIDE -->

        <div class="left-panel">
            <div class="brand">Ziggy</div>
            <div class="content">
                <h1>Welcome back!</h1>
                <p>Sign in to continue ordering your favorite food.</p>
            </div>
            <img src="/images/burger.png" alt="Burger" class="burger">
            <div class="wave">〰</div>
        </div>

        <!-- RIGHT SIDE -->

        <div class="right-panel">
            <div class="form-wrapper">
                <h2>Customer Login</h2>
                <span>Enter your details to login</span>
                <form id="loginForm">

                    <div class="input-group">

                        <label>Email Address</label>

                        <div class="input-box">

                            <i class="fa-regular fa-envelope"></i>

                            <input type="email" name="email" placeholder="Enter restaurant email" required>

                        </div>

                    </div>

                    <div class="input-group">

                        <label>Password</label>

                        <div class="input-box">

                            <i class="fa-solid fa-lock"></i>

                            <input type="password" id="password" name="password" placeholder="Enter your password">

                            <i class="fa-regular fa-eye toggle" onclick="togglePassword()"></i>

                        </div>

                    </div>
                    <div class="terms">

                        <input type="checkbox" name="rememberMe">

                        <p>
                            Remember Me
                        </p>

                    </div>



                    <div style="
                        display:flex;
                        justify-content:flex-end;
                        margin-top:10px;
                    ">
                        <a href="http://localhost:8080/forget-password" style="
                            color:#777;
                            text-decoration:none;
                        ">
                            Forgot Password?
                        </a>
                    </div>

                    <input type="submit" class="signup-btn" value="Login" id="loginBtn">

                </form>

                <div class="divider">
                    Or continue with
                </div>

                <div class="socials">

                    <button>
                        <i class="fab fa-google"></i>
                    </button>

                    <button>
                        <i class="fab fa-facebook-f"></i>
                    </button>

                    <button>
                        <i class="fab fa-apple"></i>
                    </button>

                </div>

                <div class="login-link">

                    Don't have an account?

                    <a href="http://localhost:8080/customer/register">
                        Sign Up
                    </a>

                </div>

            </div>

        </div>

    </div>

    <script>const role = "<%= role %>";</script>
    <script src="/js/common/togglePassword.js"></script>
    <script src="/js/common/toast.js"></script>
    <script src="/js/login.js"></script>
</body>

</html>