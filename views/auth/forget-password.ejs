<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>

    <link rel="stylesheet" href="/css/auth.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body>

    <div id="toast"></div>
    <div class="container">

        <!-- LEFT PANEL -->

        <div class="left-panel">

            <div class="brand">Ziggy</div>

            <div class="content">

                <h1>
                    Reset Your<br>
                    Password
                </h1>

                <p>
                    Don't worry. Enter your registered email
                    address and we'll send you a verification OTP.
                </p>

            </div>

            <img src="/images/forgot-password.png" alt="Forgot Password" class="burger">

            <div class="wave">〰</div>

        </div>

        <!-- RIGHT PANEL -->

        <div class="right-panel">

            <div class="form-wrapper">

                <h2>Forgot Password</h2>

                <span>
                    Verify your account using OTP
                </span>

                <form id="submitOTP">

                    <!-- Email -->

                    <div class="input-group">

                        <label>Email Address</label>

                        <div class="input-box">

                            <i class="fa-regular fa-envelope"></i>

                            <input type="email" name="email" id="email" placeholder="Enter registered email" required>
                            
                        </div>

                    </div>

                    <p id="emailLink" style="margin-top: 10px;display: none;">OTP link : </p>
                    <!-- Send OTP -->

                    <button type="button" class="signup-btn" id="sendOtpBtn" onclick="fetchOTP(this)">
                        Send OTP
                    </button>

                    <!-- OTP SECTION -->

                    <div id="otpSection" style="display:none;">

                        <div class="input-group">

                            <label>Verification OTP</label>

                            <div class="input-box">

                                <i class="fa-solid fa-key"></i>

                                <input type="text" name="otp" placeholder="Enter 6-digit OTP">

                            </div>

                        </div>

                        <div style="
                            margin-top:10px;
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                        ">

                            <span id="timer" style="
                                color:#ff6b00;
                                font-weight:600;
                            ">
                                02:00
                            </span>

                            <a href="#" id="resendOtp" style="
                                color:#999;
                                pointer-events:none;
                                text-decoration:none;
                            ">
                                Resend OTP
                            </a>

                        </div>

                        <button type="submit" class="signup-btn">
                            Verify OTP
                        </button>

                    </div>

                </form>

                <div class="login-link">

                    Remember your password?

                    <a href="/login">
                        Login
                    </a>

                </div>

            </div>

        </div>

    </div>

    <script src="/js/forgetPassword.js"></script>
    <script src="/js/common/toast.js"></script>

</body>

</html>