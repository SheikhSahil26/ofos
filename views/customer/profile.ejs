<!DOCTYPE html>
<html lang="en">
<head>
    <title>Profile</title>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/common/loader.css">
</head>

<body>
<p id="toast"></p>
<div id="content">
    <div class="flex min-h-screen bg-[#f8f7f4]">
    
        <%- include('../partials/customer-sidebar') %>
    
        <main class="flex-1 p-8">
    
            <!-- Page Heading -->
            <div class="mb-8">
                <h1 class="text-3xl font-semibold text-gray-800">
                    Profile
                </h1>
                <p class="text-gray-500 mt-1">
                    Manage your account information
                </p>
            </div>
    
            <!-- Profile Card -->
            <div class="bg-white rounded-3xl shadow-sm border overflow-hidden">
    
                <!-- Top Section -->
                <div class="flex justify-between bg-[#014f38] px-8 py-10">
    
                    <div class="flex items-center gap-6">
    
                        <img
                            src=""
                            alt=""
                            class="w-28 h-28 rounded-full border-4 border-white object-cover" id="profileImage">
    
                        <div class="text-white">
    
                            <h2 class="text-3xl font-semibold" id="profileName">
                                
                            </h2>
    
                            <p class="opacity-90 mt-1" id="profileEmail">
                                
                            </p>
    
                        </div>
    
                    </div>
    
                    <button
                        id="logoutBtn"
                        class="flex items-center gap-2 text-white hover:text-red-300 transition text-xl font-medium">
    
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Logout</span>
    
                    </button>
    
                </div>
    
                <!-- Information -->
                <div class="p-8">
    
                    <h3 class="text-lg font-semibold mb-6">
                        Personal Information
                    </h3>
    
                    <div class="grid md:grid-cols-2 gap-6">
    
                        <div>
                            <label class="text-sm text-gray-500">
                                Full Name
                            </label>
    
                            <p class="font-medium mt-1" id="fullName">
                                
                            </p>
                        </div>
    
                        <div>
                            <label class="text-sm text-gray-500">
                                Email
                            </label>
    
                            <p class="font-medium mt-1" id="email">
                                
                            </p>
                        </div>
    
                        <div>
                            <label class="text-sm text-gray-500">
                                Mobile Number
                            </label>
    
                            <p class="font-medium mt-1" id="mobile">
                                +91 
                            </p>
                        </div>
    
                        <!-- <div>
                            <label class="text-sm text-gray-500">
                                User ID
                            </label>
    
                            <p class="font-medium mt-1">
                                #USR001
                            </p>
                        </div> -->
    
                    </div>
    
                    <!-- Status -->
                    <div class="mt-10">
    
                        <h3 class="text-lg font-semibold mb-6">
                            Account Status
                        </h3>
    
                        <div class="flex flex-wrap gap-4">
    
                            <span class="px-4 py-2 rounded-full bg-green-100 text-green-700 text-sm font-medium" id="verifiedStatus">
                                <i class="fa-solid fa-circle-check mr-2"></i>
                                Verified
                            </span>
    
                            <span class="px-4 py-2 rounded-full bg-blue-100 text-blue-700 text-sm font-medium" id="activeStatus">
                                <i class="fa-solid fa-user-check mr-2"></i>
                                Active
                            </span>
    
                        </div>
    
                    </div>
    
                    <!-- Dates -->
                    <div class="grid md:grid-cols-2 gap-6 mt-10">
    
                        <div>
                            <label class="text-sm text-gray-500">
                                Member Since
                            </label>
    
                            <p class="font-medium mt-1" id="memberSince">
                                
                            </p>
                        </div>
    
                        <div>
                            <label class="text-sm text-gray-500">
                                Last Updated
                            </label>
    
                            <p class="font-medium mt-1" id="lastUpdated">
                                
                            </p>
                        </div>
    
                    </div>
    
                    <!-- Actions -->
                    <div class="mt-10 flex flex-wrap gap-4">
    
                        <button id="openEditProfileModal"
                            class="bg-[#ff7a00] text-white px-6 py-3 rounded-xl font-medium hover:bg-orange-600 transition">
    
                            <i class="fa-solid fa-pen-to-square mr-2"></i>
                            Edit Profile
    
                        </button>
    
                        <a href="/api/auth/reset-password"
                            class="border border-gray-300 px-6 py-3 rounded-xl font-medium hover:bg-gray-50 transition">
    
                            <i class="fa-solid fa-lock mr-2"></i>
                            Change Password
    
                        </a>
    
                    </div>
    
                </div>
            </div>
    
            <!-- Danger Zone -->
            <div class="bg-white rounded-3xl shadow-sm border mt-8 p-8">
    
                <h3 class="text-red-600 font-semibold text-lg mb-3">
                    Account Deletion
                </h3>
    
                <p class="text-gray-500 mb-6">
                    Deleting your account will permanently remove your profile,
                    orders, loyalty points and saved information.
                </p>
    
                <button
                    class="bg-red-600 text-white px-6 py-3 rounded-xl hover:bg-red-700 transition" id="deleteAccountBtn">
    
                    <i class="fa-solid fa-trash mr-2"></i>
                    Delete Ziggy Account
    
                </button>
    
            </div>
    
        </main>
    
    </div>
</div>

<!-- Include Modal -->
<%- include('./helper/edit-profile-modal') %>

<script src="/js/common/api.js"></script>
<script src="/js/common/auth.js"></script>
<script src="/js/common/toast.js"></script>
<script src="/js/customer/profile.js"></script>
<script src="/js/customer/edit-profile.js"></script>
<script src="/js/customer/edit-profile-modal.js"></script>
<script src="/js/customer/delete-profile-photo.js"></script>    
</body>
</html>
