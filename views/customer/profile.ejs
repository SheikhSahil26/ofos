<!DOCTYPE html>
<html lang="en">
<head>
    <title>Profile</title>
    <%- include('../partials/head') %>
</head>

<body>

<div class="flex min-h-screen bg-[#f8f7f4]">

    <%- include('../partials/customer-sidebar') %>

    <main class="flex-1 p-8">

        <!-- Page Heading -->
        <div class="mb-8">
            <h1 class="text-3xl font-semibold text-gray-800">
                Profile
            </h1>
            <p class="text-gray-500 mt-1">
                Manage your account information
            </p>
        </div>

        <!-- Profile Card -->
        <div class="bg-white rounded-3xl shadow-sm border overflow-hidden">

            <!-- Top Section -->
            <div class="bg-[#014f38] px-8 py-10">

                <div class="flex items-center gap-6">

                    <img
                        src="https://ui-avatars.com/api/?name=Diya+Vora&background=ff7a00&color=fff&size=256"
                        alt="Profile"
                        class="w-28 h-28 rounded-full border-4 border-white object-cover">

                    <div class="text-white">

                        <h2 class="text-3xl font-semibold">
                            Diya Vora
                        </h2>

                        <p class="opacity-90 mt-1">
                            diya@gmail.com
                        </p>

                    </div>

                </div>

            </div>

            <!-- Information -->
            <div class="p-8">

                <h3 class="text-lg font-semibold mb-6">
                    Personal Information
                </h3>

                <div class="grid md:grid-cols-2 gap-6">

                    <div>
                        <label class="text-sm text-gray-500">
                            Full Name
                        </label>

                        <p class="font-medium mt-1">
                            Diya Vora
                        </p>
                    </div>

                    <div>
                        <label class="text-sm text-gray-500">
                            Email
                        </label>

                        <p class="font-medium mt-1">
                            diya@gmail.com
                        </p>
                    </div>

                    <div>
                        <label class="text-sm text-gray-500">
                            Mobile Number
                        </label>

                        <p class="font-medium mt-1">
                            +91 9876543210
                        </p>
                    </div>

                    <div>
                        <label class="text-sm text-gray-500">
                            User ID
                        </label>

                        <p class="font-medium mt-1">
                            #USR001
                        </p>
                    </div>

                </div>

                <!-- Status -->
                <div class="mt-10">

                    <h3 class="text-lg font-semibold mb-6">
                        Account Status
                    </h3>

                    <div class="flex flex-wrap gap-4">

                        <span class="px-4 py-2 rounded-full bg-green-100 text-green-700 text-sm font-medium">
                            <i class="fa-solid fa-circle-check mr-2"></i>
                            Verified
                        </span>

                        <span class="px-4 py-2 rounded-full bg-blue-100 text-blue-700 text-sm font-medium">
                            <i class="fa-solid fa-user-check mr-2"></i>
                            Active
                        </span>

                    </div>

                </div>

                <!-- Dates -->
                <div class="grid md:grid-cols-2 gap-6 mt-10">

                    <div>
                        <label class="text-sm text-gray-500">
                            Member Since
                        </label>

                        <p class="font-medium mt-1">
                            12 January 2025
                        </p>
                    </div>

                    <div>
                        <label class="text-sm text-gray-500">
                            Last Updated
                        </label>

                        <p class="font-medium mt-1">
                            20 June 2025
                        </p>
                    </div>

                </div>

                <!-- Actions -->
                <div class="mt-10 flex flex-wrap gap-4">

                    <button
                        class="bg-[#ff7a00] text-white px-6 py-3 rounded-xl font-medium hover:bg-orange-600 transition">

                        <i class="fa-solid fa-pen-to-square mr-2"></i>
                        Edit Profile

                    </button>

                    <button
                        class="border border-gray-300 px-6 py-3 rounded-xl font-medium hover:bg-gray-50 transition">

                        <i class="fa-solid fa-lock mr-2"></i>
                        Change Password

                    </button>

                </div>

            </div>
        </div>

        <!-- Danger Zone -->
        <div class="bg-white rounded-3xl shadow-sm border mt-8 p-8">

            <h3 class="text-red-600 font-semibold text-lg mb-3">
                Account Deletion
            </h3>

            <p class="text-gray-500 mb-6">
                Deleting your account will permanently remove your profile,
                orders, loyalty points and saved information.
            </p>

            <button
                class="bg-red-600 text-white px-6 py-3 rounded-xl hover:bg-red-700 transition">

                <i class="fa-solid fa-trash mr-2"></i>
                Delete Ziggy Account

            </button>

        </div>

    </main>

</div>

</body>
</html>