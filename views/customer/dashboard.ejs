<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <title>Dashboard</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/customer/dashboard.css"/>
  </head>

  <body>
    <div class="container-fluid">
      <div class="row">
        <div class="sidebar col-md-2 p-0"><%- include("../partials/sidebar") %></div>

        <div class="col-md-10 p-0">
          <%- include("../partials/navbar") %>

          <div class="container mt-4">
            <div class="row">
              <div class="col-md-4">
                <div class="card shadow-sm">
                  <div class="card-body">
                    <h5>Profile</h5>

                    <p id="dashboardUserName" class="fw-bold">Loading...</p>

                    <p id="dashboardEmail"></p>
                  </div>
                </div>
              </div>

              <div class="col-md-4">
                <div class="card shadow-sm">
                  <div class="card-body">
                    <h5>Total Addresses</h5>

                    <h2 id="addressCount">0</h2>
                  </div>
                </div>
              </div>

              <div class="col-md-4">
                <div class="card shadow-sm">
                  <div class="card-body">
                    <h5>Default Address</h5>

                    <p id="defaultAddress">Loading...</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="/js/customer/dashboard.js"></script>
  </body>
</html>
