<!DOCTYPE html>
<html lang="en">
<head>
    <title>Dashboard</title>

    <%- include('../partials/head') %>
</head>

<body>

<div class="flex min-h-screen">

    <!-- Sidebar -->
    <%- include('../partials/customer-sidebar') %>

    
    <!-- Main Content -->
    <main class="flex-1 p-8">
        
        <!-- Welcome -->
        <div class="mb-8">
            
            <h2 class="text-3xl font-semibold text-gray-800">
                Hello, Diya 👋
            </h2>
            
            <p class="text-gray-500 mt-2">
                What would you like to eat today?
            </p>
            
            <!-- dashboard-stats -->
            <%- include("helper/dashboard-stats") %>
        </div>

        <!-- Cards -->
        <div class="grid lg:grid-cols-2 gap-6">

            <!-- Order Again -->
            <div class="bg-white rounded-2xl shadow-sm border p-6">

                <h3 class="font-semibold text-lg mb-5">
                    Order Again
                </h3>

                <div class="flex gap-4">

                    <div>
                        <img
                            src="data:image/jpeg;base64,"
                            class="w-32 h-24 rounded-xl object-cover">

                        <p class="font-medium mt-2">
                            Pizza Palace
                        </p>

                        <p class="text-sm text-gray-500">
                            2 days ago
                        </p>
                    </div>

                    <div>
                        <img
                            src="data:image/jpeg;base64,"
                            class="w-32 h-24 rounded-xl object-cover">

                        <p class="font-medium mt-2">
                            Mc Donalds
                        </p>

                        <p class="text-sm text-gray-500">
                            5 days ago
                        </p>
                    </div>

                </div>

            </div>

            <!-- Current Order -->
            <div class="bg-white rounded-2xl shadow-sm border p-6">

                <h3 class="font-semibold text-lg mb-5">
                    Current Order
                </h3>

                <p class="font-semibold">
                    ZGY123456
                </p>

                <p class="text-green-600 font-medium mt-2">
                    Out For Delivery
                </p>

                <p class="text-gray-500 text-sm mt-2">
                    Arriving in 18 mins
                </p>

                <a href="#"
                    class="inline-block mt-3 text-[#ff7a00] font-medium">

                    Track Order
                </a>

            </div>

            <!-- Ziggy Points -->
            <div class="bg-white rounded-2xl shadow-sm border p-6">

                <h3 class="font-semibold text-lg">
                    Ziggy Points
                </h3>

                <h2 class="text-5xl font-bold text-[#014f38] mt-3">
                    320
                </h2>

                <p class="text-gray-500 mt-1">
                    Available Points
                </p>

            </div>

            <!-- Quick Actions -->
            <div class="bg-white rounded-2xl shadow-sm border p-6">

                <h3 class="font-semibold text-lg mb-4">
                    Quick Actions
                </h3>

                <div class="flex gap-3 flex-wrap">

                    <a href="/customer/orders"
                        class="bg-[#014f38] text-white px-4 py-2 rounded-lg">

                        Orders
                    </a>

                    <a href="/customer/coupons"
                        class="bg-[#ff7a00] text-white px-4 py-2 rounded-lg">

                        Coupons
                    </a>

                </div>

            </div>

        </div>

    </main>

</div>

</body>
</html>