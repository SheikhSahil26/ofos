<!DOCTYPE html>
<html lang="en">

<head>
    <title>Restaurants | Ziggy</title>
    <%- include('../partials/head.ejs') %>
</head>

<body>
<p id="toast"></p>
<div class="flex min-h-screen">

    <!-- Sidebar -->
    <%- include('../partials/customer-sidebar.ejs') %>

    <div class="flex-1 flex flex-col">

        <!-- Header -->
        <header class="bg-white/90 backdrop-blur-md shadow-[0_4px_20px_-10px_rgba(0,0,0,0.05)] sticky top-0 z-30">
    <div class="px-6 py-4 flex items-center gap-6">
        
        <!-- Brand/Logo area if needed -->
        <div class="font-semibold text-gray-800 tracking-tight text-lg hidden sm:block">
            Dashboard
        </div>

        <!-- Search Bar -->
        <div class="flex-1 relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <i class="fa-solid fa-magnifying-glass text-gray-400 text-sm"></i>
            </div>
            <input
                id="searchInput"
                type="text"
                placeholder="Search..."
                class="w-full sm:w-96 bg-gray-100/50 text-gray-700 text-sm rounded-full pl-10 pr-4 py-2.5 outline-none focus:bg-gray-100 focus:ring-2 focus:ring-gray-200 transition-all">
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-2 text-gray-600">
            <button class="p-2 rounded-full hover:bg-gray-100 transition-all">
                <i class="fa-regular fa-bell"></i>
            </button>

            <button class="p-2 rounded-full hover:bg-gray-100 transition-all">
                <i class="fa-solid fa-cart-shopping"></i>
            </button>
        </div>
        
    </div>
</header>
        


        <!-- Content -->

        <main class="flex-1 p-8">

            <div class="mb-8">

                <h1 class="text-4xl font-bold text-[#014f38]">
                    Restaurants
                </h1>

                <p class="text-gray-500 mt-2">
                    Browse available restaurants
                </p>

            </div>

            <!-- Loading -->

            <div
                id="loading"
                class="flex flex-col items-center justify-center py-20">

                <i
                    class="fa-solid fa-spinner animate-spin text-3xl text-[#014f38]">
                </i>

                <p class="mt-4 text-gray-500">
                    Loading restaurants...
                </p>

            </div>

            <!-- Error -->

            <div
                id="error"
                class="hidden bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl mb-6">
            </div>

            <!-- Restaurants -->

            <div
                id="restaurantsContainer"
                class="hidden grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
            </div>

        </main>

    </div>

</div>
<script src="/js/restaurant/listing.js"></script>
<script src="/js/common/api.js"></script>
<script src="/js/common/toast.js"></script>
<script src="/js/common/auth.js"></script>
<script src="/js/customer/profile.js"></script>
</body>

</html>