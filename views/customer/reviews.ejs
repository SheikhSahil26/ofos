<!-- //review card template -->
<template id="reviewTemplate">

    <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-all duration-200 p-5">

        <!-- Header -->
        <div class="flex justify-between items-start">

            <div class="flex items-center gap-4">

                <!-- Avatar -->
                <div class="w-12 h-12 rounded-full bg-[#014f38] text-white flex items-center justify-center font-semibold text-lg review-avatar">
                    R
                </div>

                <div>

                    <h3 class="review-customer text-lg font-semibold text-gray-800">
                        Rahul Sharma
                    </h3>

                    <div class="flex items-center gap-2 mt-1">

                        <span class="review-branch text-sm text-gray-500">
                            Satellite Branch
                        </span>

                        <span class="text-gray-300">•</span>

                        <span class="review-date text-sm text-gray-500">
                            25 Jun 2026
                        </span>

                    </div>

                </div>

            </div>

            <!-- Rating -->
            <span class="review-rating bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-sm font-semibold">

                <i class="fa-solid fa-star mr-1"></i>

                4.8

            </span>

        </div>


        <!-- Order -->

        <div class="mt-5">

            <span class="review-order inline-flex items-center gap-2 bg-gray-100 text-gray-600 text-xs px-3 py-2 rounded-lg">

                <i class="fa-solid fa-receipt"></i>

                Order #ORD-10024

            </span>

        </div>


        <!-- Review -->

        <div class="mt-5">

            <p class="review-comment text-gray-700 leading-7">

                The pizza was absolutely delicious. The crust was perfectly baked and delivery was faster than expected.

            </p>

        </div>


        <!-- Customer Images -->

        <div class="review-images hidden mt-5 flex gap-3 overflow-x-auto">

            <!-- Images will be appended here -->

        </div>



        <!-- Footer -->

        <div class="flex justify-end gap-3 mt-6">

    

            <button
                class="view-order-btn bg-[#014f38] hover:bg-[#013b2a] text-white px-5 py-2 rounded-xl">

                <i class="fa-solid fa-receipt mr-2"></i>

                View Order

            </button>

        </div>

    </div>

</template>
