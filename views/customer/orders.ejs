<!DOCTYPE html>
<html lang="en">
<head>
    <title>Profile</title>
    <%- include('../partials/head') %>
</head>

<body>
<p id="toast"></p>
    <div class="flex min-h-screen bg-gray-50">

        <%- include('../partials/customer-sidebar')%>

        <main class="flex-1 p-8">

            <div class="mb-8">
                <h1 class="text-3xl font-bold text-gray-900">
                    My Orders
                </h1>

                <p class="text-gray-500 mt-2">
                    View and manage your previous orders
                </p>
            </div>

            <!-- Loading -->
            <div
                id="ordersLoading"
                class="grid grid-cols-1 lg:grid-cols-2 gap-6"
            >
                <% for(let i = 0; i < 6; i++) { %>
                    <div class="bg-white rounded-2xl p-6 animate-pulse">
                        <div class="h-5 bg-gray-200 rounded w-1/3 mb-4"></div>
                        <div class="h-4 bg-gray-200 rounded w-1/2 mb-2"></div>
                        <div class="h-4 bg-gray-200 rounded w-2/3"></div>
                    </div>
                <% } %>
            </div>

            <!-- Empty State -->
            <div
                id="emptyOrders"
                class="hidden bg-white rounded-3xl p-12 text-center"
            >
                <i class="fa-solid fa-bag-shopping text-6xl text-gray-300"></i>

                <h2 class="text-2xl font-semibold mt-5">
                    No Orders Yet
                </h2>

                <p class="text-gray-500 mt-2">
                    Looks like you haven't placed any orders yet.
                </p>

                <a
                    href="/home"
                    class="inline-flex mt-6 px-5 py-3 rounded-xl bg-[#014f38] text-white"
                >
                    Browse Menu
                </a>
            </div>

            <!-- Orders Container -->
            <div
                id="ordersContainer"
                class="hidden grid grid-cols-1 lg:grid-cols-2 gap-6"
            >
            </div>

        </main>

    </div>

    <%- include("./helper/order-details-modal") %>
    <script src="/js/common/api.js"></script>
    <script src="/js/common/auth.js"></script>
    <script src="/js/common/toast.js"></script>
    <script src="/js/customer/profile.js"></script>  
    <script src="/js/customer/orders.js"></script> 
    <script src="/js/customer/order-cards.js"></script> 
    <script src="/js/customer/order-formatter.js"></script>
    <script src="/js/customer/order-detail-modal.js"></script>
</body>
</html>
