<!-- Edit Address Modal -->
<div
    id="editAddressModal"
    class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

    <div class="bg-white w-full max-w-2xl rounded-3xl p-8 shadow-xl">

        <div class="flex justify-between items-center mb-6">

            <h2 class="text-2xl font-semibold">
                Edit Address
            </h2>

            <button
                id="closeEditAddressModal"
                class="text-gray-500 hover:text-black text-xl">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>

        <form id="editAddressForm">

            <input
                type="hidden"
                id="addressId">

            <div class="grid md:grid-cols-2 gap-4">

                <div>
                    <label class="block mb-2 text-sm font-medium">
                        Label
                    </label>

                    <input
                        type="text"
                        id="label"
                        class="w-full border rounded-xl px-4 py-3"
                        placeholder="Home / Office">
                </div>

                <div>
                    <label class="block mb-2 text-sm font-medium">
                        Pincode
                    </label>

                    <input
                        type="text"
                        id="pincode"
                        class="w-full border rounded-xl px-4 py-3">
                </div>

            </div>

            <div class="mt-4">

                <label class="block mb-2 text-sm font-medium">
                    Address Line 1
                </label>

                <input
                    type="text"
                    id="addressLine1"
                    class="w-full border rounded-xl px-4 py-3">
            </div>

            <div class="mt-4">

                <label class="block mb-2 text-sm font-medium">
                    Address Line 2
                </label>

                <input
                    type="text"
                    id="addressLine2"
                    class="w-full border rounded-xl px-4 py-3">
            </div>

            <div class="grid md:grid-cols-2 gap-4 mt-4">

                <div>
                    <label class="block mb-2 text-sm font-medium">
                        City
                    </label>

                    <input
                        type="text"
                        id="city"
                        class="w-full border rounded-xl px-4 py-3">
                </div>

                <div>
                    <label class="block mb-2 text-sm font-medium">
                        State
                    </label>

                    <input
                        type="text"
                        id="state"
                        class="w-full border rounded-xl px-4 py-3">
                </div>
            
            </div>

            <div class="grid md:grid-cols-2 gap-4 mt-4">

                <div>
                    <label class="block mb-2 text-sm font-medium">
                        Latitude
                    </label>

                    <input
                        type="text"
                        id="latitude"
                        class="w-full border rounded-xl px-4 py-3">
                </div>

                <div>
                    <label class="block mb-2 text-sm font-medium">
                        Longitude
                    </label>

                    <input
                        type="text"
                        id="longitude"
                        class="w-full border rounded-xl px-4 py-3">
                </div>

            </div>

            <div class="mt-4">

                <label class="flex items-center gap-2">

                    <input
                        type="checkbox"
                        id="isDefault">

                    <span>
                        Default Address
                    </span>

                </label>

            </div>

            <div class="flex justify-end gap-3 mt-8">

                <button
                    type="button"
                    id="cancelEditAddress"
                    class="px-5 py-3 border rounded-xl">

                    Cancel

                </button>

                <button
                    type="submit"
                    class="px-5 py-3 bg-[#ff7a00] text-white rounded-xl">

                    Save Changes

                </button>

            </div>

        </form>

    </div>

</div>