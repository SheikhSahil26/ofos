<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">

    <!-- Current Points -->
    <div class="bg-white rounded-2xl shadow-sm border p-6">

        <div class="flex justify-between items-center">

            <div>

                <p class="text-gray-500 text-sm">
                    Current Points
                </p>

                <h3
                    id="currentPoints"
                    class="text-3xl font-bold text-[#014f38] mt-2">

                    0

                </h3>

            </div>

            <div
                class="w-14 h-14 rounded-xl bg-green-100 flex items-center justify-center">

                <i class="fa-solid fa-wallet text-2xl text-[#014f38]"></i>

            </div>

        </div>

    </div>

    <!-- Total Earned -->
    <div class="bg-white rounded-2xl shadow-sm border p-6">

        <div class="flex justify-between items-center">

            <div>

                <p class="text-gray-500 text-sm">
                    Total Earned
                </p>

                <h3
                    id="totalEarned"
                    class="text-3xl font-bold mt-2">

                    0

                </h3>

            </div>

            <div
                class="w-14 h-14 rounded-xl bg-orange-100 flex items-center justify-center">

                <i class="fa-solid fa-arrow-trend-up text-2xl text-[#ff7a00]"></i>

            </div>

        </div>

    </div>

    <!-- Total Redeemed -->
    <div class="bg-white rounded-2xl shadow-sm border p-6">

        <div class="flex justify-between items-center">

            <div>

                <p class="text-gray-500 text-sm">
                    Total Redeemed
                </p>

                <h3
                    id="totalRedeemed"
                    class="text-3xl font-bold mt-2">

                    0

                </h3>

            </div>

            <div
                class="w-14 h-14 rounded-xl bg-red-100 flex items-center justify-center">

                <i class="fa-solid fa-gift text-2xl text-red-500"></i>

            </div>

        </div>

    </div>

    <!-- Total Transactions -->
    <div class="bg-white rounded-2xl shadow-sm border p-6">

        <div class="flex justify-between items-center">

            <div>

                <p class="text-gray-500 text-sm">
                    Transactions
                </p>

                <h3
                    id="totalTransactions"
                    class="text-3xl font-bold mt-2">

                    0

                </h3>

            </div>

            <div
                class="w-14 h-14 rounded-xl bg-blue-100 flex items-center justify-center">

                <i class="fa-solid fa-receipt text-2xl text-blue-500"></i>

            </div>

        </div>

    </div>

</div>