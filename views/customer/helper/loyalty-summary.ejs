<div class="grid md:grid-cols-4 gap-6 mb-8">

    <!-- Available Points -->
    <div class="bg-white rounded-2xl border p-6">

        <div class="flex justify-between items-start">

            <div>

                <p class="text-gray-500 text-sm">
                    Available Points
                </p>

                <h2
                    id="availablePoints"
                    class="text-3xl font-bold text-[#014f38] mt-2">
                    320
                </h2>

            </div>

            <div
                class="w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center">

                <i class="fa-solid fa-gift text-[#ff7a00] text-xl"></i>

            </div>

        </div>

    </div>

    <!-- Earned This Month -->
    <div class="bg-white rounded-2xl border p-6">

        <div class="flex justify-between items-start">

            <div>

                <p class="text-gray-500 text-sm">
                    Earned This Month
                </p>

                <h2
                    id="earnedThisMonth"
                    class="text-3xl font-bold text-[#014f38] mt-2">
                    +120
                </h2>

            </div>

            <div
                class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center">

                <i class="fa-solid fa-arrow-trend-up text-[#014f38] text-xl"></i>

            </div>

        </div>

    </div>

    <!-- Redeemed -->
    <div class="bg-white rounded-2xl border p-6">

        <div class="flex justify-between items-start">

            <div>

                <p class="text-gray-500 text-sm">
                    Redeemed Points
                </p>

                <h2
                    id="redeemedPoints"
                    class="text-3xl font-bold text-red-500 mt-2">
                    40
                </h2>

            </div>

            <div
                class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center">

                <i class="fa-solid fa-ticket text-red-500 text-xl"></i>

            </div>

        </div>

    </div>

    <!-- Transactions -->
    <div class="bg-white rounded-2xl border p-6">

        <div class="flex justify-between items-start">

            <div>

                <p class="text-gray-500 text-sm">
                    Transactions
                </p>

                <h2
                    id="transactionCount"
                    class="text-3xl font-bold text-[#014f38] mt-2">
                    18
                </h2>

            </div>

            <div
                class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center">

                <i class="fa-solid fa-clock-rotate-left text-blue-600 text-xl"></i>

            </div>

        </div>

    </div>

</div>