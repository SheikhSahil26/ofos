<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Partner Profile</title>

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="/css/common/toast.css">

</head>

<body class="bg-[#F8F8F8]">

<div id="toast"></div>

<!-- Navbar -->
<header class="bg-gradient-to-r from-[#014D2F] to-[#006B3F] shadow-lg">

    <div class="max-w-7xl mx-auto h-20 px-8 flex items-center justify-between">

        <h1 class="text-3xl font-bold text-orange-400">
            Ziggy Partner
        </h1>

        <div class="flex items-center gap-8 text-white">

            <a href="/partner/dashboard">
                Dashboard
            </a>

            <a href="/partner/orders">
                Orders
            </a>

            <a href="/partner/profile">
                Profile
            </a>

        </div>

    </div>

</header>


<main class="max-w-5xl mx-auto px-8 py-10">

    <div class="mb-10">

        <h1 class="text-4xl font-bold">
            Partner Profile
        </h1>

        <p class="text-gray-500 mt-2">
            Manage your delivery partner information
        </p>

    </div>


    <form
    id="partner-profile-form"
    class="space-y-8">

        <!-- Personal Information -->
        <section
        class="bg-white rounded-3xl shadow-sm p-8">

            <h2 class="text-2xl font-bold mb-8">
                Personal Information
            </h2>

            <div class="grid md:grid-cols-2 gap-6">

                <div>

                    <label class="block mb-2 font-medium">
                        Full Name
                    </label>

                    <input
                    id="name"
                    type="text"
                    class="w-full border rounded-2xl px-5 py-4">

                </div>

                <div>

                    <label class="block mb-2 font-medium">
                        Email
                    </label>

                    <input
                    id="email"
                    type="email"
                    class="w-full border rounded-2xl px-5 py-4">

                </div>

                <div>

                    <label class="block mb-2 font-medium">
                        Phone Number
                    </label>

                    <input
                    id="phone"
                    type="text"
                    class="w-full border rounded-2xl px-5 py-4">

                </div>

            </div>

        </section>



        <!-- Vehicle -->
        <section
        class="bg-white rounded-3xl shadow-sm p-8">

            <h2 class="text-2xl font-bold mb-8">
                Vehicle Information
            </h2>

            <div class="grid md:grid-cols-2 gap-6">

                <div>

                    <label class="block mb-2 font-medium">
                        Vehicle Type
                    </label>

                    <select
                    id="vehicleType"
                    class="w-full border rounded-2xl px-5 py-4">

                        <option value="">
                            Select Vehicle
                        </option>

                        <option value="BIKE">
                            Bike
                        </option>

                        <option value="SCOOTER">
                            Scooter
                        </option>

                        <option value="BICYCLE">
                            Bicycle
                        </option>

                    </select>

                </div>

                <div>

                    <label class="block mb-2 font-medium">
                        Vehicle Number
                    </label>

                    <input
                    id="vehicleNumber"
                    type="text"
                    placeholder="GJ01AB1234"
                    class="w-full border rounded-2xl px-5 py-4">

                </div>

            </div>

        </section>



        <!-- Verification -->
        <section
        class="bg-white rounded-3xl shadow-sm p-8">

            <h2 class="text-2xl font-bold mb-8">
                Verification
            </h2>

            <div class="grid md:grid-cols-2 gap-6">

                <div>

                    <label class="block mb-2 font-medium">
                        Government ID
                    </label>

                    <input
                    id="governmentId"
                    type="text"
                    placeholder="Aadhar / PAN"
                    class="w-full border rounded-2xl px-5 py-4">

                </div>

                <div>

                    <label class="block mb-2 font-medium">
                        Verification Status
                    </label>

                    <div
                    id="partner-status"
                    class="inline-flex px-5 py-3 rounded-2xl bg-yellow-100 text-yellow-700 font-semibold">

                        Pending Verification

                    </div>

                </div>

            </div>

        </section>



        <!-- Account Status -->
        <section
        class="bg-white rounded-3xl shadow-sm p-8">

            <h2 class="text-2xl font-bold mb-8">
                Account Status
            </h2>

            <div class="flex items-center justify-between">

                <div>

                    <p class="font-semibold">
                        Availability
                    </p>

                    <p class="text-gray-500">
                        Accept delivery requests
                    </p>

                </div>

                <label class="relative inline-flex items-center cursor-pointer">

                    <input
                    type="checkbox"
                    id="availability"
                    class="sr-only peer">

                    <div
                    class="
                    w-14 h-8 bg-gray-300 rounded-full
                    peer peer-checked:bg-green-600
                    after:absolute after:left-1 after:top-1
                    after:w-6 after:h-6
                    after:bg-white
                    after:rounded-full
                    after:transition-all
                    peer-checked:after:translate-x-6">

                    </div>

                </label>

            </div>

        </section>



        <div class="flex justify-end">

            <button
            type="submit"
            class="
            bg-orange-500
            hover:bg-orange-600
            text-white
            px-10 py-4
            rounded-2xl
            font-semibold">

                Save Profile

            </button>

        </div>

    </form>

</main>

<script src="/js/common/api.js"></script>
<script src="/js/common/auth.js"></script>
<script src="/js/common/toast.js"></script>
<script src="/js/delivery-partner/profile.js"></script>

</body>
</html>