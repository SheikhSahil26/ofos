<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Delivery Partner Dashboard</title>

<script src="https://cdn.tailwindcss.com"></script>

</head>
<body class="bg-[#F8F8F8]">

    <div id="toast"></div>

<!-- Navbar -->
<header class="bg-gradient-to-r from-[#014D2F] to-[#006B3F] shadow-lg">

    <div class="max-w-7xl mx-auto h-20 px-8 flex items-center justify-between">

        <h1 class="text-3xl font-bold text-orange-400">
            Ziggy Partner
        </h1>

        <div class="flex items-center gap-8 text-white">

            <button>Dashboard</button>
            <button>Orders</button>
            <button>Earnings</button>
            <button>Profile</button>

        </div>

    </div>

</header>


<main class="max-w-7xl mx-auto px-8 py-10">

    <!-- Top Stats -->
    <div class="grid grid-cols-4 gap-6 mb-10">

        <div class="bg-white rounded-3xl p-6 shadow-sm">

            <p class="text-gray-500">
                Today's Earnings
            </p>

            <h2 class="text-4xl font-bold mt-4 text-green-600">
                ₹840
            </h2>

        </div>

        <div class="bg-white rounded-3xl p-6 shadow-sm">

            <p class="text-gray-500">
                Deliveries Today
            </p>

            <h2 class="text-4xl font-bold mt-4">
                8
            </h2>

        </div>

        <div class="bg-white rounded-3xl p-6 shadow-sm">

            <p class="text-gray-500">
                Rating
            </p>

            <h2 class="text-4xl font-bold text-orange-500 mt-4">
                4.8
            </h2>

        </div>

        <div class="bg-white rounded-3xl p-6 shadow-sm">

            <div class="flex justify-between items-center">

                <div>

                    <p class="text-gray-500">
                        Availability
                    </p>

                    <h2 class="text-xl font-bold mt-3 text-green-600">
                        Online
                    </h2>

                </div>

                <label class="relative inline-flex items-center cursor-pointer">

                    <input
                    type="checkbox"
                    checked
                    class="sr-only peer">

                    <div class="
                    w-14 h-8 bg-gray-300 rounded-full
                    peer peer-checked:bg-green-600
                    after:absolute after:left-1 after:top-1
                    after:w-6 after:h-6 after:bg-white
                    after:rounded-full after:transition-all
                    peer-checked:after:translate-x-6">

                    </div>

                </label>

            </div>

        </div>

    </div>


    <!-- Notification -->
    <div class="bg-orange-100 border-l-8 border-orange-500 rounded-3xl p-6 mb-10">

        <div class="flex justify-between items-center">

            <div>

                <h2 class="text-xl font-bold text-orange-700">

                    🔔 New Delivery Request

                </h2>

                <p class="mt-2 text-orange-600">

                    Pizza Palace → Customer (4.5 km)

                </p>

            </div>

            <button
            class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-3 rounded-2xl">

                Accept Order

            </button>

        </div>

    </div>



    <div class="grid grid-cols-3 gap-8">

        <!-- Active Orders -->
        <div class="col-span-2">

            <h2 class="text-3xl font-bold mb-8">
                Active Orders
            </h2>

            <div class="space-y-6">

                <% for(let i=0;i<3;i++){ %>

                <div class="bg-white rounded-3xl p-8 shadow-sm">

                    <div class="flex justify-between">

                        <div>

                            <h3 class="text-2xl font-bold">
                                Order #1042
                            </h3>

                            <p class="text-gray-500 mt-3">
                                Pizza Palace
                            </p>

                            <p class="text-gray-500">
                                4.5 km Away
                            </p>

                        </div>

                        <span
                        class="bg-orange-100 text-orange-600 px-5 py-3 rounded-2xl">

                            Waiting

                        </span>

                    </div>

                    <div class="flex gap-4 mt-8">

                        <button
                        class="bg-[#014D2F] hover:bg-[#02653f]
                        text-white px-6 py-3 rounded-2xl">

                            View Route

                        </button>

                        <button
                        class="bg-orange-500 hover:bg-orange-600
                        text-white px-6 py-3 rounded-2xl">

                            Accept

                        </button>

                    </div>

                </div>

                <% } %>

            </div>

        </div>



        <!-- Assigned Order -->
        <div>

            <div class="bg-white rounded-3xl p-8 shadow-sm sticky top-28">

                <h2 class="text-2xl font-bold mb-8">
                    Current Order
                </h2>

                <div class="space-y-5">

                    <div>

                        <p class="text-gray-500">
                            Order ID
                        </p>

                        <h3 class="font-bold text-xl">
                            #1037
                        </h3>

                    </div>

                    <div>

                        <p class="text-gray-500">
                            Restaurant
                        </p>

                        <h3 class="font-bold">
                            Pizza Palace
                        </h3>

                    </div>

                    <div>

                        <p class="text-gray-500">
                            Customer
                        </p>

                        <h3 class="font-bold">
                            Sahil Sheikh
                        </h3>

                    </div>

                    <div>

                        <p class="text-gray-500">
                            Distance
                        </p>

                        <h3 class="font-bold">
                            3.8 km
                        </h3>

                    </div>

                </div>

                <button
                class="w-full mt-10 bg-green-600 hover:bg-green-700 text-white py-4 rounded-2xl font-semibold">

                    Picked Up

                </button>

                <button
                class="w-full mt-4 bg-orange-500 hover:bg-orange-600 text-white py-4 rounded-2xl font-semibold">

                    Delivered

                </button>

            </div>

        </div>

    </div>


    <!-- Recent Deliveries -->
    <div class="mt-16">

        <h2 class="text-3xl font-bold mb-8">
            Recent Deliveries
        </h2>

        <div class="bg-white rounded-3xl shadow-sm overflow-hidden">

            <table class="w-full">

                <thead class="bg-gray-50">

                    <tr>

                        <th class="text-left px-8 py-5">
                            Order
                        </th>

                        <th class="text-left">
                            Restaurant
                        </th>

                        <th class="text-left">
                            Earnings
                        </th>

                        <th class="text-left">
                            Status
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <% for(let i=0;i<5;i++){ %>

                    <tr class="border-t">

                        <td class="px-8 py-5">
                            #1025
                        </td>

                        <td>
                            Burger Hub
                        </td>

                        <td class="text-green-600 font-bold">
                            ₹80
                        </td>

                        <td>

                            <span class="
                            bg-green-100
                            text-green-700
                            px-4 py-2 rounded-xl">

                                Delivered

                            </span>

                        </td>

                    </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </div>

</main>

<script src="/js/common/api.js"></script>
<script src="/js/common/toast.js"></script>
<script src="/js/common/auth.js"></script>
<script src="/js/delivery-partner/deliveryPartner.js"></script>

</body>
</html>