<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        Coupon Management
    </title>

    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="stylesheet" href="/css/common/toast.css">
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>

<body class="bg-gray-50">

    <div class="flex min-h-screen bg-[#f5f7f6]">

        <!-- Sidebar Here -->
         <%- include("../partials/admin/sidebar") %>

        <main class="flex-1 p-8">

            <div class="flex justify-between items-center mb-8">

                <div>

                    <h1 class="text-3xl font-bold text-[#014f38]">
                        Coupon Management
                    </h1>

                    <p class="text-gray-500 mt-1">
                        Manage platform-wide coupons
                    </p>

                </div>

                <button
                    id="addCouponBtn"
                    class="bg-[#ff7a00] hover:bg-[#e86f00] text-white px-5 py-3 rounded-xl">

                    <i class="fa-solid fa-plus mr-2"></i>

                    Create Coupon

                </button>

            </div>

            <div
                id="couponContainer"
                class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
            </div>

        </main>

    </div>

    <!-- Coupon Card Template -->

    <template id="couponTemplate">

        <div class="bg-white rounded-2xl shadow-sm p-5">

            <div class="flex justify-between items-start">

                <div>

                    <h3
                        class="coupon-code text-xl font-bold text-[#014f38]">
                    </h3>

                    <p
                        class="coupon-type text-sm text-gray-500 mt-1">
                    </p>

                </div>

               <label class="relative inline-flex items-center cursor-pointer">

    <input
        type="checkbox"
        class="coupon-status-toggle sr-only peer">

    <div
        class="w-14 h-7 bg-gray-300 rounded-full
               peer-checked:bg-[#014f38]
               transition-all duration-300">
    </div>

    <div
        class="absolute top-1 left-1 w-5 h-5 bg-white rounded-full shadow
               transition-all duration-300
               peer-checked:translate-x-7">
    </div>

</label>

            </div>

            <div class="mt-4">

                <p
                    class="coupon-discount text-2xl font-bold text-[#ff7a00]">
                </p>

                <p
                    class="coupon-min-order text-sm text-gray-500 mt-2">
                </p>

                <p
                    class="coupon-max-discount text-sm text-gray-500 mt-1">
                </p>

                <p
                    class="coupon-usage-limit text-sm text-gray-500 mt-1">
                </p>

            </div>

            <div class="border-t mt-4 pt-4">

                <p
                    class="coupon-validity text-xs text-gray-400">
                </p>

            </div>

            <div class="flex gap-2 mt-4">

                <button
                    class="edit-coupon-btn flex-1 border border-[#014f38] text-[#014f38] py-2 rounded-lg">

                    Edit

                </button>

                <button
                    class="stats-coupon-btn flex-1 bg-[#014f38] text-white py-2 rounded-lg">

                    Stats

                </button>

            </div>

        </div>

    </template>

    <!-- Create/Edit Coupon Modal -->

    <div
        id="couponModal"
        class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

        <div class="bg-white rounded-2xl w-full max-w-2xl p-6">

            <h2 class="text-2xl font-bold text-[#014f38] mb-6">
                Create Coupon
            </h2>

            <form id="couponForm">

                <input
                    type="hidden"
                    id="editingCouponId">

                <div class="grid grid-cols-2 gap-4">

                    <div>

                        <label class="block mb-2">
                            Coupon Code
                        </label>

                        <input
                            id="couponCode"
                            type="text"
                            class="w-full border rounded-xl px-4 py-3">

                    </div>

                    <div>

                        <label class="block mb-2">
                            Coupon Type
                        </label>

                        <select
                            id="couponType"
                            class="w-full border rounded-xl px-4 py-3">

                            <option value="PERCENTAGE">
                                Percentage
                            </option>

                            <option value="FLAT">
                                Flat
                            </option>

                        </select>

                    </div>

                    <div>

                        <label class="block mb-2">
                            Discount Value
                        </label>

                        <input
                            id="discountValue"
                            type="number"
                            class="w-full border rounded-xl px-4 py-3">

                    </div>

                    <div>

                        <label class="block mb-2">
                            Min Order Amount
                        </label>

                        <input
                            id="minOrderAmount"
                            type="number"
                            class="w-full border rounded-xl px-4 py-3">

                    </div>

                    <div>

                        <label class="block mb-2">
                            Max Discount
                        </label>

                        <input
                            id="maxDiscount"
                            type="number"
                            class="w-full border rounded-xl px-4 py-3">

                    </div>

                    <div>

                        <label class="block mb-2">
                            Usage Limit
                        </label>

                        <input
                            id="usageLimit"
                            type="number"
                            class="w-full border rounded-xl px-4 py-3">

                    </div>

                    <div>

                        <label class="block mb-2">
                            Start Date
                        </label>

                        <input
                            id="startDate"
                            type="datetime-local"
                            class="w-full border rounded-xl px-4 py-3">

                    </div>

                    <div>

                        <label class="block mb-2">
                            End Date
                        </label>

                        <input
                            id="endDate"
                            type="datetime-local"
                            class="w-full border rounded-xl px-4 py-3">

                    </div>

                </div>

                <div class="mt-6 flex gap-3">

                    <button
                        type="button"
                        id="closeCouponModal"
                        class="flex-1 border rounded-xl py-3">

                        Cancel

                    </button>

                    <button
                        type="submit"
                        class="flex-1 bg-[#ff7a00] text-white rounded-xl py-3">

                        Save Coupon

                    </button>

                </div>

            </form>

        </div>

    </div>
    <script src="/js/common/toast.js"></script>
    <script src="/js/common/api.js"></script>
    <script src="/js/admin/coupon-management.js"></script>

</body>

</html>