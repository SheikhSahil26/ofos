<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        body {
            background: #F5F7F6;
        }

        .sidebar {
            background: #0B5D3B;
        }

        .active-menu {
            background: #FF8A00;
        }

        .card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        }
    </style>
</head>

<body>

<div class="flex min-h-screen">

    <!-- Sidebar -->
    <aside class="sidebar w-64 text-white flex flex-col p-5">

        <div class="mb-8">
            <h1 class="text-3xl font-bold text-orange-400">
                Zesty
            </h1>
        </div>

        <nav class="space-y-2">

            <a href="#" class="active-menu flex items-center gap-3 px-4 py-3 rounded-xl">
                📊 Dashboard
            </a>

            <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-green-700">
                👥 Users
            </a>

            <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-green-700">
                🍽 Restaurants
            </a>

            <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-green-700">
                📦 Orders
            </a>

            <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-green-700">
                💳 Payments
            </a>

            <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-green-700">
                🎟 Coupons
            </a>

            <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-green-700">
                🎁 Rewards
            </a>

            <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-green-700">
                📢 Promotions
            </a>

            <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-green-700">
                ⚙️ Settings
            </a>

            <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-green-700">
                🚪 Logout
            </a>

        </nav>

    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-8">

        <h1 class="text-3xl font-bold text-gray-800 mb-8">
            Admin Analytics Dashboard
        </h1>

        <!-- Stats -->
        <div class="grid grid-cols-4 gap-6 mb-8">

            <div class="card p-5">
                <p class="text-gray-500 text-sm">GMV</p>
                <h2 class="text-3xl font-bold mt-2">₹25,67,890</h2>
                <p class="text-green-600 text-sm mt-2">+12.8%</p>
            </div>

            <div class="card p-5">
                <p class="text-gray-500 text-sm">Total Orders</p>
                <h2 class="text-3xl font-bold mt-2">5,432</h2>
                <p class="text-green-600 text-sm mt-2">+8.2%</p>
            </div>

            <div class="card p-5">
                <p class="text-gray-500 text-sm">Active Customers</p>
                <h2 class="text-3xl font-bold mt-2">3,210</h2>
                <p class="text-green-600 text-sm mt-2">+6.3%</p>
            </div>

            <div class="card p-5">
                <p class="text-gray-500 text-sm">New Restaurants</p>
                <h2 class="text-3xl font-bold mt-2">132</h2>
                <p class="text-green-600 text-sm mt-2">+15.4%</p>
            </div>

        </div>

        <!-- Charts Section -->
        <div class="grid grid-cols-3 gap-6 mb-8">

            <!-- Order Overview -->
            <div class="card p-6 col-span-2">

                <div class="flex justify-between mb-6">
                    <h3 class="font-semibold text-lg">
                        Order Overview
                    </h3>

                    <div class="text-sm text-gray-500">
                        Orders: 430
                    </div>
                </div>

                <div class="h-64 flex items-end gap-3">

                    <div class="w-6 bg-orange-200 h-20 rounded"></div>
                    <div class="w-6 bg-orange-300 h-28 rounded"></div>
                    <div class="w-6 bg-orange-400 h-40 rounded"></div>
                    <div class="w-6 bg-orange-500 h-32 rounded"></div>
                    <div class="w-6 bg-orange-400 h-24 rounded"></div>
                    <div class="w-6 bg-orange-500 h-44 rounded"></div>
                    <div class="w-6 bg-orange-400 h-36 rounded"></div>
                    <div class="w-6 bg-orange-500 h-52 rounded"></div>
                    <div class="w-6 bg-orange-400 h-44 rounded"></div>
                    <div class="w-6 bg-orange-500 h-60 rounded"></div>

                </div>

            </div>

            <!-- Top Restaurants -->
            <div class="card p-6">

                <h3 class="font-semibold text-lg mb-6">
                    Top Performing Restaurants
                </h3>

                <div class="space-y-4">

                    <div class="flex justify-between">
                        <span>1. Pizza Palace</span>
                        <span>₹1,25,430</span>
                    </div>

                    <div class="flex justify-between">
                        <span>2. Burger Barn</span>
                        <span>₹98,760</span>
                    </div>

                    <div class="flex justify-between">
                        <span>3. Biryani House</span>
                        <span>₹87,450</span>
                    </div>

                    <div class="flex justify-between">
                        <span>4. Wok This Way</span>
                        <span>₹68,230</span>
                    </div>

                    <div class="flex justify-between">
                        <span>5. South Spice</span>
                        <span>₹54,300</span>
                    </div>

                </div>

            </div>

        </div>

        <!-- Bottom Section -->
        <div class="grid grid-cols-2 gap-6">

            <!-- Order Status -->
            <div class="card p-6">

                <h3 class="font-semibold text-lg mb-6">
                    Order Status Distribution
                </h3>

                <div class="flex items-center justify-center">

                    <div class="w-44 h-44 rounded-full border-[25px]
                        border-green-500 border-r-orange-300
                        border-b-red-300 border-l-yellow-400">
                    </div>

                </div>

                <div class="mt-6 space-y-2 text-sm">

                    <div class="flex justify-between">
                        <span>Delivered</span>
                        <span>68%</span>
                    </div>

                    <div class="flex justify-between">
                        <span>Cancelled</span>
                        <span>12%</span>
                    </div>

                    <div class="flex justify-between">
                        <span>On The Way</span>
                        <span>10%</span>
                    </div>

                    <div class="flex justify-between">
                        <span>Other</span>
                        <span>10%</span>
                    </div>

                </div>

            </div>

            <!-- Revenue -->
            <div class="card p-6">

                <h3 class="font-semibold text-lg mb-6">
                    Revenue Breakdown
                </h3>

                <div class="flex items-center justify-center">

                    <div class="w-44 h-44 rounded-full border-[25px]
                        border-green-600 border-r-orange-400
                        border-b-yellow-400 border-l-green-400">
                    </div>

                </div>

                <div class="mt-6 space-y-2 text-sm">

                    <div class="flex justify-between">
                        <span>Restaurants</span>
                        <span>70%</span>
                    </div>

                    <div class="flex justify-between">
                        <span>Delivery Partners</span>
                        <span>20%</span>
                    </div>

                    <div class="flex justify-between">
                        <span>Platform</span>
                        <span>10%</span>
                    </div>

                </div>

            </div>

        </div>

    </main>

</div>

</body>
</html>