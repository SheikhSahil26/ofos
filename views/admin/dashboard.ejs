<!DOCTYPE html>
<html lang="en">

<%- include('../partials/admin/head',{title:"Admin Page"}) %>

    <body class="bg-slate-100">

        <div class="flex min-h-screen">

            <!-- SIDEBAR -->
            <%- include('../partials/admin/sidebar') %>

                <!-- MAIN -->

                <main class="flex-1 p-8">

                    <!-- HEADER -->
                    <%- include('../partials/admin/topbar') %>

                        <!-- KPI CARDS -->
                        <div>

                            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">

                                <div class="bg-white p-6 rounded-3xl shadow-sm">

                                    <h4 class="text-gray-500">
                                        GMV
                                    </h4>

                                    <h2 class="text-3xl font-bold mt-3">
                                        ₹25,67,890
                                    </h2>

                                    <p class="text-green-600 mt-2">
                                        +12.5%
                                    </p>

                                </div>

                                <div class="bg-white p-6 rounded-3xl shadow-sm">

                                    <h4 class="text-gray-500">
                                        Total Orders
                                    </h4>

                                    <h2 class="text-3xl font-bold mt-3">
                                        5,432
                                    </h2>

                                    <p class="text-green-600 mt-2">
                                        +8.4%
                                    </p>

                                </div>

                                <div class="bg-white p-6 rounded-3xl shadow-sm">

                                    <h4 class="text-gray-500">
                                        Active Customers
                                    </h4>

                                    <h2 class="text-3xl font-bold mt-3">
                                        3,210
                                    </h2>

                                    <p class="text-green-600 mt-2">
                                        +5.1%
                                    </p>

                                </div>

                                <div class="bg-white p-6 rounded-3xl shadow-sm">

                                    <h4 class="text-gray-500">
                                        New Restaurants
                                    </h4>

                                    <h2 class="text-3xl font-bold mt-3">
                                        132
                                    </h2>

                                    <p class="text-green-600 mt-2">
                                        +10.8%
                                    </p>

                                </div>

                            </div>

                            <!-- CHARTS -->

                            <div class="grid lg:grid-cols-3 gap-6 mt-8">

                                <div class="bg-white rounded-3xl p-6 lg:col-span-2">

                                    <h3 class="font-bold mb-4">
                                        Revenue Overview
                                    </h3>

                                    <canvas id="revenueChart"></canvas>

                                </div>

                                <div class="bg-white rounded-3xl p-6">

                                    <h3 class="font-bold mb-4">
                                        Order Distribution
                                    </h3>

                                    <canvas id="orderPie"></canvas>

                                </div>

                            </div>

                            <!-- TABLES -->

                            <div class="grid lg:grid-cols-2 gap-6 mt-8">

                                <div class="bg-white rounded-3xl p-6">

                                    <h3 class="font-bold mb-4">
                                        Top Restaurants
                                    </h3>

                                    <table class="w-full">

                                        <tr class="border-b">
                                            <td class="py-3">Pizza Palace</td>
                                            <td>₹1,25,430</td>
                                        </tr>

                                        <tr class="border-b">
                                            <td class="py-3">Burger Barn</td>
                                            <td>₹98,700</td>
                                        </tr>

                                        <tr class="border-b">
                                            <td class="py-3">Biryani House</td>
                                            <td>₹87,450</td>
                                        </tr>

                                        <tr>
                                            <td class="py-3">Wok This Way</td>
                                            <td>₹61,320</td>
                                        </tr>

                                    </table>

                                </div>

                                <div class="bg-white rounded-3xl p-6">

                                    <h3 class="font-bold mb-4">
                                        Recent Activities
                                    </h3>

                                    <div class="space-y-4">

                                        <div class="border-l-4 border-orange-500 pl-4">
                                            New restaurant approved
                                        </div>

                                        <div class="border-l-4 border-green-500 pl-4">
                                            Payout completed
                                        </div>

                                        <div class="border-l-4 border-blue-500 pl-4">
                                            New admin report generated
                                        </div>

                                    </div>

                                </div>

                            </div>
                        </div>

                </main>

        </div>

        <script src="/js/admin-dashboard.js"></script>
        <script src="/js/admin/admin-sidebar.js"></script>

    </body>

</html>