
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Your Cart | Ziggy</title>

<link rel="stylesheet" href="/css/common/toast.css">

<script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-[#F8F8F8]">

<div id="toast"></div>

<!-- NAVBAR -->
<header class="sticky top-0 z-50 bg-gradient-to-r from-[#014D2F] to-[#006B3F] shadow-lg">

    <div class="max-w-7xl mx-auto h-20 px-4 sm:px-6 lg:px-8 flex items-center justify-between">

        <div class="flex items-center gap-4">

            <button
            onclick="history.back()"
            class="text-white text-2xl">

                ←

            </button>

            <h1 class="text-3xl font-bold text-orange-400">
                Ziggy
            </h1>

        </div>

        <div class="hidden md:flex items-center gap-8 text-white">

            <button class="hover:text-orange-300 transition">
                Home
            </button>

            <button class="hover:text-orange-300 transition">
                Orders
            </button>

            <button class="hover:text-orange-300 transition">
                Profile
            </button>

        </div>

    </div>

</header>



<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- PAGE HEADER -->
    <div class="flex flex-wrap gap-4 justify-between items-center mb-10">

        <div>

            <h1 class="text-4xl font-bold">
                Your Cart
            </h1>

            <p class="text-gray-500 mt-2">
                Review your selected items before checkout
            </p>

        </div>

        <div
        class="bg-white border border-gray-100 rounded-2xl px-5 py-3 shadow-sm">

            

            <span
           id="item-count"
            class="ml-2 font-bold text-orange-500">

                0

            </span>

        </div>

    </div>



    <div class="grid lg:grid-cols-3 gap-8">

        <!-- LEFT -->
        <div
        id="cart-items-container"
        class="lg:col-span-2 space-y-5">

            <!-- Cart Items Render Here -->

        </div>



        <!-- RIGHT -->
        <div>

            <div
            class="bg-white rounded-3xl border border-gray-100 shadow-lg p-8 lg:sticky lg:top-28">

                <h2 class="font-bold text-2xl mb-8">

                    Order Summary

                </h2>


                <!-- FREE DELIVERY BOX -->
                <div
                class="bg-green-50 border border-green-100 rounded-2xl p-4 mb-6">

                    <p class="text-green-700 font-medium">

                        Free delivery above ₹199

                    </p>

                </div>


                <div class="space-y-5">

                    <div class="flex justify-between">

                        <span class="text-gray-500">
                            Subtotal
                        </span>

                        <span
                        id="summary-subtotal"
                        class="font-medium">

                            ₹0

                        </span>

                    </div>

                    <div class="flex justify-between">

                        <span class="text-gray-500">
                            Delivery Fee
                        </span>

                        <span
                        id="summary-delivery-fee"
                        class="font-medium">

                            ₹40

                        </span>

                    </div>

                    <div class="flex justify-between">

                        <span class="text-gray-500">
                            Taxes
                        </span>

                        <span
                        id="summary-tax"
                        class="font-medium">

                            ₹0

                        </span>

                    </div>

                    <hr>

                    <div
                    class="flex justify-between text-2xl font-bold">

                        <span>
                            Total
                        </span>

                        <span
                        id="summary-total">

                            ₹0

                        </span>

                    </div>

                </div>


                <button
                id="checkout-btn"
               
                class="
                w-full
                mt-8
                bg-orange-500
                hover:bg-orange-600
                text-white
                py-5
                rounded-2xl
                font-bold
                text-lg
                transition
                shadow-lg
                hover:shadow-xl">

                    <a href="/customer/checkout">
                        Proceed To Checkout
                    </a>

                </button>


                <div
                class="mt-6 text-center text-sm text-gray-500">

                    Secure Checkout

                </div>

            </div>

        </div>

    </div>

</main>

<script src="/js/common/api.js"></script>
<script src="/js/common/toast.js"></script>
<script src="/js/common/auth.js"></script>
<script src="/js/cart/seeCartPage.js"></script>

</body>
</html>

