<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Cart</title>
<link rel="stylesheet" href="/css/auth.css">
<script src="https://cdn.tailwindcss.com"></script>
></script>
</head>

<body class="bg-[#f8f8f8]">

     <div id="toast"></div>

<!-- Navbar -->
<header class="bg-gradient-to-r from-[#014D2F] to-[#006B3F] shadow-lg">

    <div class="max-w-7xl mx-auto h-20 px-8 flex items-center justify-between">

        <h1 class="text-3xl font-bold text-orange-400">
            Ziggy
        </h1>

        <div class="flex items-center gap-8 text-white">
            <button>Home</button>
            <button>Orders</button>
            <button>Profile</button>
        </div>

    </div>

</header>


<main class="max-w-7xl mx-auto px-8 py-10">

    <h1 class="text-4xl font-bold mb-10">
        Your Cart
    </h1>

    <div class="grid lg:grid-cols-3 gap-8">

        <!-- Left Side -->
        <div class="lg:col-span-2 space-y-6" id="cart-items-container">

          <!-- cart items from backend here -->

        </div>


        <!-- Right Side -->
        <div>

            <div class="bg-white rounded-3xl shadow-sm p-8 sticky top-32">

                <h2 class="font-bold text-2xl mb-8">
                    Order Summary
                </h2>

                <div class="space-y-5">

                    <div class="flex justify-between">
                        <span class="text-gray-500">
                            Subtotal
                        </span>

                        <span id="summary-subtotal">
                            
                        </span>
                    </div>

                    <div class="flex justify-between">
                        <span class="text-gray-500">
                            Delivery Fee
                        </span>

                        <span id="summary-delivery-fee">
                           
                        </span>
                    </div>

                    <div class="flex justify-between">
                        <span class="text-gray-500">
                            Taxes
                        </span>

                        <span id="summary-tax">
                            
                        </span>
                    </div>

                    <hr>

                    <div class="flex justify-between text-xl font-bold">

                        <span>Total</span>

                        <span id="summary-total">
                            
                        </span>

                    </div>

                </div>

                <button
                class="w-full mt-8 bg-orange-500 hover:bg-orange-600 text-white py-4 rounded-2xl font-semibold">

                    Proceed To Checkout

                </button>

            </div>

        </div>

    </div>

</main>

<script src="/js/common/api.js"></script>
<script src="/js/cart/seeCartPage.js"></script>
 <script src="/js/common/toast.js"></script>
 <script src="/js/common/auth.js"></script>

</body>
</html>