<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restaurant Menu</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        ::-webkit-scrollbar {
            display: none;
        }
    </style>
</head>
<body class="bg-[#F9F9F9]">

    <%- include('../partials/customer-sidebar.ejs') %>

    <!-- Header -->
    <header class="bg-gradient-to-r from-[#014D2F] to-[#006B3F] text-white sticky top-0 z-50 shadow-md">

        <div class="max-w-md mx-auto px-4 h-16 flex items-center justify-between">

            <div class="flex items-center gap-4">
                <button>
                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="w-6 h-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor">

                        <path stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"/>
                    </svg>
                </button>

                <h1 class="text-2xl font-bold text-orange-400">
                    Ziggy
                </h1>
            </div>

            <div class="flex items-center gap-5">

                <!-- Search -->
                <button>
                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor">

                        <path stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </button>

                <!-- Cart -->
                <button class="relative">
                    🛒
                    <span class="absolute -top-2 -right-2 bg-orange-500 text-white text-[10px] rounded-full w-4 h-4 flex items-center justify-center">
                        2
                    </span>
                </button>

                <!-- Notification -->
                <button class="relative">
                    🔔
                    <span class="absolute -top-2 -right-2 bg-orange-500 text-white text-[10px] rounded-full w-4 h-4 flex items-center justify-center">
                        3
                    </span>
                </button>

            </div>

        </div>

    </header>

    <main class="max-w-md mx-auto pb-28">

        <!-- Restaurant Info -->
        <section class="bg-white p-4">

            <div class="flex gap-4">

                <img
                    src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38"
                    alt=""
                    class="w-20 h-20 rounded-xl object-cover">

                <div class="flex-1">

                    <h2 class="font-bold text-xl">
                        Pizza Palace
                    </h2>

                    <div class="flex items-center gap-2 text-sm text-gray-600 mt-2">
                        <span class="text-green-600">★ 4.5</span>
                        <span>(1.2k)</span>
                        <span>•</span>
                        <span>30 mins</span>
                    </div>

                    <p class="text-sm text-gray-500 mt-1">
                        ₹200 min order • Free delivery above ₹199
                    </p>

                    <div class="inline-flex items-center px-3 py-1 rounded-lg bg-green-100 text-green-700 text-xs mt-3">
                        50% OFF up to ₹100 on orders above ₹199
                    </div>

                </div>

            </div>

        </section>

        <!-- Tabs -->
        <section class="bg-white border-t border-gray-100">

            <div class="flex">

                <button class="flex-1 py-4 font-semibold text-orange-500 border-b-2 border-orange-500">
                    Menu
                </button>

                <button class="flex-1 py-4 text-gray-500">
                    Reviews (1.2k)
                </button>

                <button class="flex-1 py-4 text-gray-500">
                    Info
                </button>

            </div>

        </section>

        <!-- Categories -->
        <section class="bg-white px-4 py-3">

            <div class="flex gap-3 overflow-x-auto">

                <button class="whitespace-nowrap px-5 py-2 rounded-lg bg-orange-500 text-white font-medium">
                    Recommended
                </button>

                <button class="whitespace-nowrap px-5 py-2 rounded-lg border border-gray-200">
                    Pizza
                </button>

                <button class="whitespace-nowrap px-5 py-2 rounded-lg border border-gray-200">
                    Sides
                </button>

                <button class="whitespace-nowrap px-5 py-2 rounded-lg border border-gray-200">
                    Beverages
                </button>

                <button class="whitespace-nowrap px-5 py-2 rounded-lg border border-gray-200">
                    Desserts
                </button>

            </div>

        </section>

        <!-- Menu Items -->
        <section class="p-3 space-y-4">

            <% for(let i=0;i<4;i++){ %>

                <div class="bg-white rounded-2xl p-3 shadow-sm border border-gray-100">

                    <div class="flex gap-4">

                        <img
                            src="https://images.unsplash.com/photo-1513104890138-7c749659a591"
                            class="w-24 h-24 rounded-xl object-cover">

                        <div class="flex-1">

                            <div class="flex justify-between">

                                <h3 class="font-bold text-lg">
                                    Margherita Pizza
                                </h3>

                                <span class="text-green-600">
                                    ●
                                </span>

                            </div>

                            <p class="text-gray-500 text-sm mt-1">
                                Classic delight with 100% real mozzarella
                                cheese & fresh basil.
                            </p>

                            <div class="flex justify-between items-end mt-4">

                                <span class="font-bold text-lg">
                                    ₹199
                                </span>

                                <button
                                    class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-2 rounded-lg font-medium transition">

                                    Add +

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            <% } %>

        </section>

    </main>

    <!-- Sticky Cart -->
    <div class="fixed bottom-4 left-1/2 -translate-x-1/2 w-full max-w-md px-4">

        <button
            class="w-full bg-gradient-to-r from-[#014D2F] to-[#006B3F]
            text-white py-4 rounded-2xl shadow-xl
            flex justify-between items-center px-6">

            <span class="font-semibold">
                View Cart • 3 Items
            </span>

            <span class="font-bold">
                ₹548
            </span>

        </button>

    </div>

</body>
</html>