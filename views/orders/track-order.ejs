<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Track Order</title>

<link rel="stylesheet" href="/css/common/toast.css">

<link
rel="stylesheet"
href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<script src="https://cdn.tailwindcss.com"></script>

<script
src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
</script>

</head>

<body class="bg-[#F8F8F8]">

<div id="toast"></div>

<header class="sticky top-0 z-50 bg-gradient-to-r from-[#014D2F] to-[#006B3F] shadow-lg">

    <div class="max-w-7xl mx-auto h-20 px-8 flex items-center justify-between">

        <div class="flex items-center gap-5">

            <button class="text-white text-xl">
                ←
            </button>

            <h1 class="text-3xl font-bold text-orange-400">
                Ziggy
            </h1>

        </div>

        <button class="text-white font-semibold">
            Help
        </button>

    </div>

</header>

<main class="max-w-7xl mx-auto px-8 py-10">

<div class="grid lg:grid-cols-3 gap-8">

<!-- LEFT -->
<div class="lg:col-span-2 space-y-8">

<!-- Order Header -->
<section class="bg-white rounded-3xl shadow-sm p-8">

    <div class="flex justify-between items-center">

        <div>

            <p class="text-gray-500">
                Order
            </p>

            <h2 id="orderNumber" class="text-3xl font-bold mt-2">
                #ZOYT23456
            </h2>

        </div>

        <span
            id="statusBadge"
            class="bg-orange-100 text-orange-600 px-5 py-3 rounded-2xl font-semibold">

            Out For Delivery

        </span>

    </div>

</section>


<!-- Progress -->
<section class="bg-white rounded-3xl shadow-sm p-8">

    <div
        id="stepperContainer"
        class="flex justify-between">

    </div>

</section>


<!-- Status -->
<section
id="statusSection"
class="bg-white rounded-3xl shadow-sm p-8">

    <h1 id="statusHeadline" class="text-4xl font-bold">

        Your order is on the way

    </h1>

    <p
        id="etaText"
        class="text-green-600 text-xl mt-4 font-semibold">

        Arriving in 18 mins

    </p>

</section>


<!-- Map -->
<section class="bg-white rounded-3xl shadow-sm p-4">

    <div
        id="map"
        style="height:500px;width:100%">
    </div>

</section>

</div>



<!-- RIGHT -->
<div class="space-y-8">


<!-- Delivery Partner -->
<section
id="partnerSection"
class="bg-white rounded-3xl shadow-sm p-8">

    <h2 class="text-2xl font-bold mb-8">
        Delivery Partner
    </h2>

    <div class="flex items-center justify-between">

        <div class="flex gap-5">

            <img
                id="partnerImage"
                src="https://randomuser.me/api/portraits/men/32.jpg"
                class="w-20 h-20 rounded-full object-cover">

            <div>

                <h3
                    id="partnerName"
                    class="font-bold text-xl">

                    Rahul Kumar

                </h3>

                <div class="flex items-center gap-3 mt-3">

                    <span class="text-orange-500">
                        ★
                    </span>

                    <span id="partnerRating">

                        4.6

                    </span>

                </div>

                <p class="text-gray-500 mt-2">
                    Your Delivery Partner
                </p>

            </div>

        </div>

    </div>

    <div class="grid grid-cols-2 gap-4 mt-10">

        <button
            id="callPartnerBtn"
            class="bg-green-600 text-white py-4 rounded-2xl font-semibold">

            Call

        </button>

        <button
            class="border border-green-600 text-green-600 py-4 rounded-2xl font-semibold">

            Chat

        </button>

    </div>

</section>



<!-- Address -->
<section
id="addressSection"
class="bg-white rounded-3xl shadow-sm p-8">

    <h2 class="font-bold text-2xl mb-8">

        Delivery Address

    </h2>

    <div>

        <p
            id="addressLine"
            class="font-semibold text-lg">

            #12, 2nd Cross, Koramangala 5th Block

        </p>

        <p
            id="cityLine"
            class="text-gray-500 mt-4">

            Bengaluru, Karnataka 560095

        </p>

    </div>

</section>



<!-- Support -->
<section class="bg-white rounded-3xl shadow-sm p-8">

    <h2 class="font-bold text-2xl mb-8">

        Need Help?

    </h2>

    <button
        id="supportBtn"
        class="w-full bg-orange-500 hover:bg-orange-600 text-white py-4 rounded-2xl font-semibold">

        Contact Support

    </button>

</section>

</div>

</div>

</main>


<script src="/js/common/api.js"></script>
<script src="/js/common/toast.js"></script>
<script src="/js/common/auth.js"></script>
<script src="/js/orders/trackOrder.js"></script>

</body>
</html>