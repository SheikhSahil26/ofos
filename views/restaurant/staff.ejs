<!DOCTYPE html>
<html lang="en">
<head>
    <title>Staff Management | Ziggy Restaurant</title>
    <%- include('../partials/head.ejs') %>
    <style>
        .staff-card {
            transition: all 0.2s ease-in-out;
        }
        .staff-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
    </style>
</head>
<body class="bg-[#f8f7f4] min-h-screen">
    <p id="toast"></p>

    <!-- Dashboard Layout -->
    <div class="flex min-h-screen">

        <%- include('../partials/restaurant-sidebar.ejs') %>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col h-screen overflow-y-auto">
            <main class="flex-1 px-4 md:px-8 py-6 max-w-7xl mx-auto w-full">

                <!-- Page Heading & Branch Selector -->
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-900">
                            Staff Management
                        </h1>
                        <p class="text-gray-500 mt-1">
                            Manage employees across your restaurant branches.
                        </p>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-3">
                        <!-- Branch Selector -->
                        <div class="bg-white px-4 py-2 rounded-xl shadow-sm border border-gray-100 flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-[#e6f4f0] text-[#014f38] flex items-center justify-center">
                                <i class="fa-solid fa-store"></i>
                            </div>
                            <div>
                                <label for="branchSelector" class="block text-xs font-medium text-gray-500">Selected Branch</label>
                                <select id="branchSelector" class="bg-transparent border-none text-sm font-semibold text-gray-900 focus:ring-0 p-0 cursor-pointer min-w-[150px]">
                                    <option value="">Loading branches...</option>
                                </select>
                            </div>
                        </div>

                        <!-- Add Staff Button -->
                        <button id="addStaffBtn" class="bg-[#014f38] text-white px-6 py-2.5 rounded-xl hover:bg-[#013d2c] transition shadow-md font-semibold flex items-center justify-center gap-2">
                            <i class="fa-solid fa-plus"></i> Add Staff
                        </button>
                    </div>
                </div>

                <!-- Loading State -->
                <div id="staffLoading" class="flex flex-col items-center justify-center py-20">
                    <div class="w-10 h-10 border-4 border-[#e6f4f0] border-t-[#014f38] rounded-full animate-spin"></div>
                    <p class="text-gray-500 mt-4 font-medium">Loading staff...</p>
                </div>

                <!-- Main Staff Board -->
                <div id="staffBoard" class="hidden">
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-gray-50 border-b border-gray-100 text-xs uppercase text-gray-500 font-semibold tracking-wider">
                                        <th class="p-4">Name</th>
                                        <th class="p-4">Contact</th>
                                        <th class="p-4">Role</th>
                                        <th class="p-4 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="staffTableBody" class="divide-y divide-gray-100 text-sm">
                                    <!-- Populated via JS -->
                                </tbody>
                            </table>
                        </div>

                        <!-- Empty State -->
                        <div id="emptyStaffState" class="hidden flex-col items-center justify-center py-16">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-3">
                                <i class="fa-solid fa-users-slash text-2xl text-gray-400"></i>
                            </div>
                            <p class="text-gray-900 font-bold text-lg mb-1">No staff members found</p>
                            <p class="text-gray-500 font-medium mb-4">You haven't added any staff to this branch yet.</p>
                            <button onclick="document.getElementById('addStaffBtn').click()" class="text-[#014f38] font-bold hover:underline">
                                + Add First Staff Member
                            </button>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <!-- Add Staff Modal - Step 1: Check Email -->
    <div id="checkEmailModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm transition-opacity p-4">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300" id="checkEmailPanel">
            
            <div class="flex items-center justify-between p-6 border-b border-gray-100">
                <h2 class="text-xl font-bold text-gray-900">Add Staff</h2>
                <button id="closeCheckEmailModal" class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-200 transition">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="checkEmailForm" class="p-6 space-y-4">
                <p class="text-sm text-gray-500 mb-2">Enter the email address of the staff member. We will check if they already have an account.</p>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                    <input type="email" id="checkStaffEmail" required class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-[#014f38]/20 focus:border-[#014f38] outline-none transition" placeholder="john@example.com">
                </div>

                <div class="pt-4">
                    <button type="submit" id="submitCheckEmailBtn" class="w-full bg-[#014f38] text-white py-3 rounded-xl font-bold hover:bg-[#013d2c] transition shadow-md flex items-center justify-center gap-2">
                        <span>Continue</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Existing User Popup Modal -->
    <div id="existingUserModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-white w-full max-w-sm rounded-2xl p-6 shadow-2xl text-center">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4 text-blue-500 text-2xl">
                <i class="fa-solid fa-user-check"></i>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">User Already Exists!</h3>
            <p class="text-gray-500 text-sm mb-6">This user already has an account and has been successfully added to this branch. They can use their existing password to login.</p>
            <button onclick="closeExistingUserModal()" class="w-full py-3 rounded-xl bg-[#014f38] text-white font-bold hover:bg-[#013d2c] transition shadow-md flex items-center justify-center">
                Go to Staff Page
            </button>
        </div>
    </div>

    <!-- Add Staff Modal - Step 2: Full Details -->
    <div id="addStaffModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm transition-opacity p-4">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300" id="addStaffPanel">
            
            <div class="flex items-center justify-between p-6 border-b border-gray-100">
                <h2 class="text-xl font-bold text-gray-900">Create Staff Profile</h2>
                <button id="closeAddStaffModal" class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-200 transition">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="addStaffForm" class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                    <input type="email" id="staffEmail" disabled class="w-full bg-gray-200 border border-gray-300 text-gray-500 text-sm rounded-xl px-4 py-2.5 outline-none cursor-not-allowed">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                    <input type="text" id="staffName" required class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-[#014f38]/20 focus:border-[#014f38] outline-none transition" placeholder="John Doe">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Mobile Number</label>
                    <input type="tel" id="staffMobile" required class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-[#014f38]/20 focus:border-[#014f38] outline-none transition" placeholder="9876543210">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Temporary Password</label>
                    <input type="password" id="staffPassword" required class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-[#014f38]/20 focus:border-[#014f38] outline-none transition" placeholder="••••••••">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
                    <input type="password" id="staffConfirmPassword" required class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-[#014f38]/20 focus:border-[#014f38] outline-none transition" placeholder="••••••••">
                </div>

                <div class="pt-4">
                    <button type="submit" id="submitStaffBtn" class="w-full bg-[#014f38] text-white py-3 rounded-xl font-bold hover:bg-[#013d2c] transition shadow-md flex items-center justify-center gap-2">
                        <span>Save Staff Member</span>
                    </button>
                </div>
            </form>

        </div>
    </div>

    <!-- Confirm Delete Modal -->
    <div id="deleteModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-white w-full max-w-sm rounded-2xl p-6 shadow-2xl text-center">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4 text-red-500 text-2xl">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Remove Staff?</h3>
            <p class="text-gray-500 text-sm mb-6">Are you sure you want to remove <strong id="deleteStaffName">this person</strong> from this branch? They will lose access immediately.</p>
            <div class="flex gap-3 w-full">
                <button onclick="closeDeleteModal()" class="w-full py-2.5 rounded-xl bg-gray-100 text-gray-700 font-bold hover:bg-gray-200 transition">Cancel</button>
                <button id="confirmDeleteBtn" class="w-full py-2.5 rounded-xl bg-red-500 text-white font-bold hover:bg-red-600 transition shadow-md flex items-center justify-center">Remove</button>
            </div>
        </div>
    </div>

    <script src="/js/common/toast.js"></script>
    <script src="/js/common/auth.js"></script>
    <script src="/js/common/api.js"></script>
    <script src="/js/restaurant/staff.js"></script>

</body>
</html>
