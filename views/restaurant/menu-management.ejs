<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Menu Management</title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">


    <link rel="stylesheet" href="/css/common/toast.css">
    <link rel="stylesheet" href="/css/restaurant/toggle.css">
</head>

<body>
    <p id="toast"></p>

    <input type="text" hidden value="<%= branchId %>" id="branchId">

    <div class="flex min-h-screen bg-[#f5f7f6]">

        <%- include('../partials/restaurant-sidebar') %>

        <main class="flex-1 p-8">

            <!-- Menu Management Content -->

            <div class="flex-1 bg-[#f5f7f6] p-8 overflow-auto">

    <!-- Header -->
    <div class="flex justify-between items-center mb-8">

        <div>

            <h1 class="text-3xl font-bold text-[#014f38]">
                Menu Management
            </h1>

            <p class="text-gray-500 mt-1">
                Manage categories, menu items and modifiers
            </p>

        </div>

        <div class="flex gap-3">

            <button
                id="addCategoryBtn"
                class="bg-white border border-[#014f38] text-[#014f38] px-5 py-3 rounded-xl font-medium">

                + Category

            </button>

            <button id="addMenuItemBtn"
                class="bg-[#ff7a00] text-white px-4 py-2 rounded-xl">
                <i class="fa-solid fa-plus mr-2"></i>
                Add Item
            </button>

        </div>

    </div>

    <!-- Search -->
    <div class="mb-6">

        <input
            type="text"
            placeholder="Search menu items..."
            class="w-full bg-white rounded-2xl px-5 py-4 outline-none shadow-sm">

    </div>

    <!-- Content -->
    <div class="grid grid-cols-12 gap-6">

        <!-- Categories -->
        <div class="col-span-3">

            <div class="bg-white rounded-2xl shadow-sm p-5">

                <h2 class="font-semibold text-[#014f38] mb-4">
                    Categories
                </h2>

                <div id="categoryList" class="space-y-2">

                    

                </div>

            </div>

        </div>

        <!-- Menu Items -->
        <div class="col-span-9">

            <!-- right panel header -->
            <div
                class="bg-white rounded-2xl p-5 shadow-sm mb-5">

                <div class="flex justify-between items-center">

                    <div>

                        <h2
                            id="selectedCategoryName"
                            class="text-2xl font-bold text-[#014f38]">

                            

                        </h2>

                        <p
                            id="selectedCategoryCount"
                            class="text-gray-500 mt-1">

                            

                        </p>

                    </div>

                    <div class="flex gap-3">

                        <button
                            id="editCategoryBtn"
                            class="
                                px-4
                                py-2
                                border
                                border-[#014f38]
                                text-[#014f38]
                                rounded-lg
                                hover:bg-[#014f38]
                                hover:text-white
                                transition
                            ">

                            <i class="fa-solid fa-pen mr-2"></i>
                            Edit Category

                        </button>

                        <button
                            id="deleteCategoryBtn"
                            class="
                                px-4
                                py-2
                                bg-red-500
                                text-white
                                rounded-lg
                                hover:bg-red-600
                                transition
                            ">

                            <i class="fa-solid fa-trash mr-2"></i>
                            Delete Category

                        </button>

                        

                    </div>

                </div>

            </div>

            <div
                id="menuItemsContainer"
                class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
            </div>

        </div>

        <!-- template for the menu item card -->
        <template id="menuItemTemplate">

            <div
                class="bg-white rounded-2xl shadow-sm overflow-hidden">

                <img
                    class="item-image w-full h-40 object-cover">

                <div class="p-5">

                    <div class="flex justify-between items-start">

                        <h3
                            class="item-name font-semibold text-lg">
                        </h3>

                        <span
                            class="item-type text-xs px-2 py-1 rounded-full">
                        </span>
                        

                       <button class="delete-item-btn px-4 border border-red-300 text-red-500 rounded-lg hover:bg-red-50">
                            <i class="fa-solid fa-trash"></i>
                        </button>


                    </div>

                    <p
                        class="item-description text-gray-500 text-sm mt-2">
                    </p>

                    <p
                        class="item-price text-[#014f38] font-bold text-lg mt-3">
                    </p>

                    <div class="mt-4 space-y-3">

                        <div class="flex items-center justify-between">

                            <span class="text-sm text-gray-600">
                                 <i class="fa-solid fa-circle text-green-500 text-xs"></i>
                                Available
                            </span>

                            <label class="toggle-switch">

                                <input
                                    type="checkbox"
                                    class="availability-toggle">

                                <span class="slider"></span>

                            </label>

                        </div>

                        <div class="flex items-center justify-between">

                            <span class="text-sm text-gray-600">
                                
                                Bestseller
                            </span>

                            <label class="toggle-switch">

                                <input
                                    type="checkbox"
                                    class="bestseller-toggle">

                                <span class="slider"></span>

                            </label>

                        </div>

                    </div>

                    <div class="flex gap-2 mt-4">

                        <button
                            class="edit-btn flex-1 border border-[#014f38] text-[#014f38] py-2 rounded-lg">
                            Edit
                        </button>

                        <button
                            class="modifier-btn flex-1 bg-[#014f38] text-white py-2 rounded-lg">
                            Modifiers
                        </button>


                    </div>

                </div>

            </div>

        </template>

    </div>

</div>

        </main>

    </div>


    <!-- create category modal -->
    <div
        id="categoryModal"
        class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50">

        <input type="hidden" id="editingCategoryId">

        <div class="bg-white w-full max-w-md rounded-2xl p-6">

            <div class="flex justify-between items-center mb-5">

                <h2 id="categoryModalTitle" class="text-xl font-bold text-[#014f38]">
                    Create Category
                </h2>

                <button id="closeCategoryModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>

            </div>

            <form id="categoryForm">

                <div class="mb-4">

                    <label class="block mb-2 text-sm font-medium">
                        Category Name
                    </label>

                    <input
                        id="categoryName"
                        type="text"
                        class="w-full border rounded-xl px-4 py-3"
                        placeholder="e.g. Starters">

                </div>

                <button
                    type="submit" id="saveCategoryBtn"
                    class="w-full bg-[#ff7a00] text-white py-3 rounded-xl">

                    Create Category

                </button>

            </form>

        </div>

    </div>


    <!-- Delete Category Modal -->
    <div id="deleteCategoryModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
        
        <div class="bg-white rounded-2xl w-full max-w-md p-6 shadow-xl">

            <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mx-auto">
                <i class="fa-solid fa-trash text-red-500 text-2xl"></i>
            </div>

            <div class="text-center mt-4">
                <h2 class="text-2xl font-bold text-[#014f38]">Delete Category</h2>

                <p class="text-gray-500 mt-3">
                    Are you sure you want to delete
                    <span id="deleteCategoryName" class="font-semibold text-[#014f38]"></span>?
                </p>

                <p class="text-sm text-gray-400 mt-2">
                    This category will be hidden from the menu.
                </p>
            </div>

            <div class="flex gap-3 mt-8">
                <button id="cancelDeleteBtn" class="flex-1 border border-gray-300 py-3 rounded-xl hover:bg-gray-50 transition">
                    Cancel
                </button>

                <button id="confirmDeleteBtn" class="flex-1 bg-red-500 text-white py-3 rounded-xl hover:bg-red-600 transition">
                    Delete
                </button>
            </div>

        </div>

    </div>


    <!-- create menu item modal-->
     <div id="menuItemModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

        <!-- for editing purpose -->
        <input type="hidden" id="editingMenuItemId">
        <div class="bg-white rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto p-6">

            <h2 class="text-2xl font-bold text-[#014f38] mb-6">Add Menu Item</h2>

            <form id="menuItemForm">

                <div class="mb-4">
                    <label class="block mb-2">Item Name</label>
                    <input id="itemName" type="text" class="w-full border rounded-xl px-4 py-3">
                </div>

                <div class="mb-4">
                    <label class="block mb-2">Description</label>
                    <textarea id="itemDescription" class="w-full border rounded-xl px-4 py-3"></textarea>
                </div>

                <div class="mb-4">
                    <label class="block mb-2">Price</label>
                    <input id="itemPrice" type="number" class="w-full border rounded-xl px-4 py-3">
                </div>

                <div class="mb-4">
                    <label class="block mb-2">Food Type</label>

                    <div class="flex gap-6">
                        <label class="flex items-center gap-2">
                            <input type="radio" name="foodType" value="true" checked>
                            <span>Veg</span>
                        </label>

                        <label class="flex items-center gap-2">
                            <input type="radio" name="foodType" value="false">
                            <span>Non Veg</span>
                        </label>
                    </div>
                </div>

                <div class="mb-4">
                    <img
                        id="editItemImagePreview"
                        class="w-full h-48 object-cover rounded-xl border">

                    <label
                        for="itemImage"
                        class="
                            inline-flex
                            items-center
                            gap-2
                            mt-3
                            text-[#014f38]
                            font-medium
                            cursor-pointer
                        ">
                        <i class="fa-solid fa-image"></i>
                        Change Image
                    </label>

                    <input
                        type="file"
                        id="itemImage"
                        accept="image/*"
                        class="hidden">
                </div>


                <div id="tagsContainer" class="flex flex-wrap gap-2 mb-6"></div>

                <div class="flex gap-3">
                    <button type="button" id="closeMenuItemModal" class="flex-1 border rounded-xl py-3">
                        Cancel
                    </button>

                    <button type="submit" class="flex-1 bg-[#ff7a00] text-white rounded-xl py-3">
                        Create Item
                    </button>
                </div>

            </form>

        </div>

    </div>

    <!-- delete item modal -->
     <div
        id="deleteMenuItemModal"
        class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

        <div class="bg-white rounded-2xl w-full max-w-md p-6">

            <div class="text-center">

                <i class="fa-solid fa-trash text-red-500 text-4xl"></i>

                <h2 class="text-2xl font-bold mt-4">
                    Delete Menu Item
                </h2>

                <p class="mt-3 text-gray-500">
                    Are you sure you want to delete
                    <span
                        id="deleteMenuItemName"
                        class="font-semibold">
                    </span>
                    ?
                </p>

            </div>

            <div class="flex gap-3 mt-6">

                <button
                    id="cancelDeleteMenuItemBtn"
                    class="flex-1 border py-3 rounded-xl">
                    Cancel
                </button>

                <button
                    id="confirmDeleteMenuItemBtn"
                    class="flex-1 bg-red-500 text-white py-3 rounded-xl">
                    Delete
                </button>

            </div>

        </div>

    </div>

    <!-- template for modifier group -->
    <template id="modifierGroupTemplate">

        <div class="border rounded-xl p-4 mb-4">

            <div class="flex justify-between items-center">

                <div>

                    <h3 class="group-name font-semibold text-lg"></h3>

                    <p class="group-details text-sm text-gray-500"></p>

                </div>

                

                <span class="group-option-count text-sm text-[#014f38]"></span>




            </div>

            <div class="group-options mt-3"></div>

            <div class="flex gap-2 mt-4">
                <button class="add-option-btn flex-1 border border-[#014f38] text-[#014f38] py-2 rounded-lg">
                    Add Option
                </button>

                <button class="edit-group-btn px-4 border rounded-lg">
                    Edit
                </button>

                <button class="delete-group-btn px-4 border border-red-300 text-red-500 rounded-lg">
                    Delete
                </button>
            </div>
            

        </div>

    </template>

    <!-- open modifier grps -->
     <div id="modifierModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

        <div class="bg-white rounded-2xl w-full max-w-4xl p-6 max-h-[90vh] overflow-y-auto">

            <div class="flex justify-between items-center mb-6">

                <h2 class="text-2xl font-bold text-[#014f38]">
                    Modifier Groups
                </h2>

                <button id="closeModifierModal">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>

            </div>
            <div>
                <button id="addModifierGroupBtn"
                    class="mb-4 bg-[#014f38] text-white px-4 py-2 rounded-lg">
                    + Add Modifier Group
                </button>
            </div>
            <div id="modifierGroupsContainer"></div>

        </div>

    </div>

    <!-- create modifier group modal -->
     <div id="modifierGroupModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

        <div class="bg-white rounded-2xl w-full max-w-md p-6">

            <!-- for editing purpose -->
            <input type="hidden" id="editingGroupId">

            <h2 class="text-2xl font-bold text-[#014f38] mb-6">
                Create Modifier Group
            </h2>

            <form id="modifierGroupForm">

                <div class="mb-4">
                    <label class="block mb-2">Group Name</label>
                    <input id="groupName" type="text" class="w-full border rounded-xl px-4 py-3">
                </div>

                <div class="mb-4">
                    <label class="flex items-center gap-2">
                        <input id="isRequired" type="checkbox">
                        Required
                    </label>
                </div>

                <div class="mb-4">
                    <label class="block mb-2">Min Selection</label>
                    <input id="minSelection" type="number" value="0" class="w-full border rounded-xl px-4 py-3">
                </div>

                <div class="mb-6">
                    <label class="block mb-2">Max Selection</label>
                    <input id="maxSelection" type="number" value="1" class="w-full border rounded-xl px-4 py-3">
                </div>

                <div class="flex gap-3">
                    <button type="button" id="closeModifierGroupModal" class="flex-1 border py-3 rounded-xl">
                        Cancel
                    </button>

                    <button type="submit" class="flex-1 bg-[#014f38] text-white py-3 rounded-xl">
                        Create
                    </button>
                </div>

            </form>

        </div>

    </div>

    <!-- create option modal -->
     <div id="modifierOptionModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

        <div class="bg-white rounded-2xl w-full max-w-md p-6">

            <!-- for edit  -->
            <input type="hidden" id="editingOptionId">

            <h2 class="text-2xl font-bold text-[#014f38] mb-6">
                Create Modifier Option
            </h2>

            <form id="modifierOptionForm">

                <div class="mb-4">
                    <label class="block mb-2">Option Name</label>
                    <input id="optionName" type="text" class="w-full border rounded-xl px-4 py-3">
                </div>

                <div class="mb-6">
                    <label class="block mb-2">Extra Price</label>
                    <input id="extraPrice" type="number" min="0" value="0" class="w-full border rounded-xl px-4 py-3">
                </div>

                <div class="flex gap-3">
                    <button type="button" id="closeModifierOptionModal" class="flex-1 border py-3 rounded-xl">
                        Cancel
                    </button>

                    <button type="submit" class="flex-1 bg-[#014f38] text-white py-3 rounded-xl">
                        Create
                    </button>
                </div>

            </form>

        </div>

    </div>


    <!-- confirm modal to delete option -->
     <div id="confirmModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

        <div class="bg-white rounded-3xl p-8 w-full max-w-md text-center">

            <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-red-100 flex items-center justify-center">
                <i class="fa-solid fa-trash text-red-500 text-3xl"></i>
            </div>

            <h2 id="confirmTitle" class="text-3xl font-bold text-[#014f38] mb-3">
                Delete Item
            </h2>

            <p id="confirmMessage" class="text-gray-600 mb-2">
                Are you sure?
            </p>

            <p class="text-gray-400 text-sm mb-8">
                This action cannot be undone.
            </p>

            <div class="flex gap-3">
                <button id="cancelConfirmBtn"
                    class="flex-1 border border-gray-300 rounded-xl py-3">
                    Cancel
                </button>

                <button id="confirmActionBtn"
                    class="flex-1 bg-red-500 hover:bg-red-600 text-white rounded-xl py-3">
                    Delete
                </button>
            </div>

        </div>

    </div>

    <script src="/js/common/toast.js"></script>
    <script src="/js/common/api.js"></script>
    <script  src="/js/restaurant/create-category.js"></script>
    <script src="/js/restaurant/menu-management.js"></script>
    <script src="/js/restaurant/modifier-management.js"></script>
</body>
</html>