<!DOCTYPE html>
<html lang="en">
<head>
    <title>Orders | Ziggy Restaurant</title>
    <%- include('../partials/head.ejs') %>
    <style>
        .order-card {
            transition: all 0.2s ease-in-out;
        }
        .order-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        .tab-btn.active {
            border-bottom: 2px solid #014f38;
            color: #014f38;
            font-weight: 600;
        }
        .status-badge {
            font-size: 0.7rem;
            padding: 0.2rem 0.5rem;
            border-radius: 999px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    </style>
</head>
<body class="bg-[#f8f7f4] min-h-screen">
    <p id="toast"></p>

    <!-- Dashboard Layout -->
    <div class="flex min-h-screen">

        <%- include('../partials/restaurant-sidebar.ejs') %>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col h-screen overflow-y-auto">
            <main class="flex-1 px-4 md:px-8 py-6 max-w-7xl mx-auto w-full">

                <!-- Page Heading & Branch Selector -->
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-900">
                            Orders Dashboard
                        </h1>
                        <p class="text-gray-500 mt-1">
                            Manage your restaurant's incoming and active orders.
                        </p>
                    </div>

                    <!-- Branch Selector -->
                    <div class="bg-white px-4 py-2 rounded-xl shadow-sm border border-gray-100 flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-[#e6f4f0] text-[#014f38] flex items-center justify-center">
                            <i class="fa-solid fa-store"></i>
                        </div>
                        <div>
                            <label for="branchSelector" class="block text-xs font-medium text-gray-500">Selected Branch</label>
                            <select id="branchSelector" class="bg-transparent border-none text-sm font-semibold text-gray-900 focus:ring-0 p-0 cursor-pointer min-w-[150px]">
                                <option value="">Loading branches...</option>
                            </select>
                        </div>
                        <button id="refreshOrdersBtn" class="ml-2 text-gray-400 hover:text-[#014f38] transition" title="Refresh Orders">
                            <i class="fa-solid fa-arrow-rotate-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Loading State -->
                <div id="ordersLoading" class="flex flex-col items-center justify-center py-20">
                    <div class="w-10 h-10 border-4 border-[#e6f4f0] border-t-[#014f38] rounded-full animate-spin"></div>
                    <p class="text-gray-500 mt-4 font-medium">Loading orders...</p>
                </div>

                <!-- Main Orders Board (Hidden initially) -->
                <div id="ordersBoard" class="hidden flex-col">
                    
                    <!-- Tabs -->
                    <div class="flex border-b border-gray-200 mb-6 overflow-x-auto hide-scrollbar">
                        <button class="tab-btn active px-6 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="new">
                            New & Pending
                            <span id="badge-new" class="ml-2 bg-red-100 text-red-600 px-2 py-0.5 rounded-full text-xs hidden">0</span>
                        </button>
                        <button class="tab-btn px-6 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="preparing">
                            Preparing
                            <span id="badge-preparing" class="ml-2 bg-blue-100 text-blue-600 px-2 py-0.5 rounded-full text-xs hidden">0</span>
                        </button>
                        <button class="tab-btn px-6 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="ready">
                            Ready / Out for Delivery
                            <span id="badge-ready" class="ml-2 bg-orange-100 text-orange-600 px-2 py-0.5 rounded-full text-xs hidden">0</span>
                        </button>
                        <button class="tab-btn px-6 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="completed">
                            History (Completed/Cancelled)
                        </button>
                    </div>

                    <!-- Tab Contents -->
                    <div class="relative min-h-[400px]">
                        <!-- New Orders Tab -->
                        <div id="tab-new" class="tab-content grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                            <!-- Populated via JS -->
                        </div>

                        <!-- Preparing Tab -->
                        <div id="tab-preparing" class="tab-content hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                            <!-- Populated via JS -->
                        </div>

                        <!-- Ready/Out Tab -->
                        <div id="tab-ready" class="tab-content hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                            <!-- Populated via JS -->
                        </div>

                        <!-- Completed Tab -->
                        <div id="tab-completed" class="tab-content hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                            <!-- Populated via JS -->
                        </div>

                        <!-- Empty State within tabs -->
                        <div id="emptyTabState" class="hidden absolute inset-0 flex flex-col items-center justify-center">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-3">
                                <i class="fa-solid fa-receipt text-2xl text-gray-400"></i>
                            </div>
                            <p class="text-gray-500 font-medium">No orders in this category.</p>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <!-- Order Details Modal (Slide Over) -->
    <div id="orderDetailsModal" class="hidden fixed inset-0 z-50 flex justify-end bg-black/50 backdrop-blur-sm transition-opacity">
        <div id="orderDetailsPanel" class="bg-white w-full max-w-md h-full flex flex-col shadow-2xl transform translate-x-full transition-transform duration-300">
            
            <!-- Modal Header -->
            <div class="flex items-center justify-between p-6 border-b border-gray-100">
                <div>
                    <h2 class="text-xl font-bold text-gray-900" id="modalOrderId">Order #---</h2>
                    <p class="text-xs text-gray-500 mt-1" id="modalOrderTime">---</p>
                </div>
                <button id="closeOrderModal" class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-200 transition">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Modal Content (Scrollable) -->
            <div class="flex-1 overflow-y-auto p-6">
                <!-- Status Banner -->
                <div class="mb-6 rounded-xl p-4 flex items-center justify-between" id="modalStatusBanner">
                    <span class="font-bold text-sm uppercase tracking-wide" id="modalStatusText">STATUS</span>
                    <i class="fa-solid fa-circle-info text-lg opacity-70"></i>
                </div>

                <!-- Customer Details -->
                <div class="mb-6">
                    <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-user text-gray-400"></i> Customer
                    </h3>
                    <div class="bg-gray-50 rounded-xl p-4">
                        <p class="font-bold text-gray-900" id="modalCustomerName">Customer Name</p>
                        <p class="text-sm text-gray-600 mt-1" id="modalCustomerPhone"><i class="fa-solid fa-phone text-xs mr-1"></i> ---</p>
                        <div class="mt-3 pt-3 border-t border-gray-200" id="modalDeliveryAddressBlock">
                            <p class="text-xs text-gray-500 font-medium mb-1">Delivery Address</p>
                            <p class="text-sm text-gray-800" id="modalDeliveryAddress">---</p>
                        </div>
                    </div>
                </div>

                <!-- Order Items -->
                <div class="mb-6">
                    <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-utensils text-gray-400"></i> Items (<span id="modalItemsCount">0</span>)
                    </h3>
                    <div class="space-y-3" id="modalItemsList">
                        <!-- Items injected here -->
                    </div>
                </div>

                <!-- Financial Breakdown -->
                <div class="mb-6 bg-gray-50 rounded-xl p-4">
                    <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Bill Details</h3>
                    <div class="space-y-2 text-sm text-gray-600" id="modalBillDetails">
                        <div class="flex justify-between"><span>Item Total</span><span id="modalSubtotal">₹0</span></div>
                        <div class="flex justify-between"><span>Tax & Charges</span><span id="modalTax">₹0</span></div>
                        <div class="flex justify-between"><span>Delivery Fee</span><span id="modalDeliveryFee">₹0</span></div>
                        <div class="flex justify-between text-green-600" id="modalDiscountRow"><span>Discount <span id="modalCouponBadge" class="ml-1 hidden bg-green-100 text-green-800 px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider"></span></span><span id="modalDiscount">-₹0</span></div>
                        <div class="flex justify-between font-bold text-lg text-gray-900 pt-2 border-t border-gray-200 mt-2">
                            <span>Total</span><span id="modalTotal">₹0</span>
                        </div>
                    </div>
                    <div class="mt-3 pt-3 border-t border-gray-200 text-xs text-center text-gray-500 font-medium uppercase" id="modalPaymentStatus">
                        PAID VIA CARD
                    </div>
                </div>
            </div>

            <!-- Modal Footer (Actions) -->
            <div class="p-6 border-t border-gray-100 bg-white" id="modalActionButtons">
                <!-- Action buttons injected based on status -->
            </div>

        </div>
    </div>

    <script src="/js/common/toast.js"></script>
    <script src="/js/common/auth.js"></script>
    <script src="/js/common/api.js"></script>
    <script src="/js/restaurant/orders.js"></script>

</body>
</html>
