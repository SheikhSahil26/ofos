<aside class="w-72 bg-[#014f38] text-white flex flex-col p-6 sticky top-0 h-screen">

    <!-- Logo -->
    <div class="mb-10">
        <h1 class="text-3xl font-bold text-[#ff7a00]">
            Ziggy
        </h1>
    </div>

    <!-- Navigation -->
    <nav class="flex flex-col gap-2">

        <!-- Home -->
        <a href="/"
            class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/10 transition">
            <i class="fa-solid fa-house"></i>
            <span>Home</span>
        </a>

        <!-- Dashboard -->
        <a href="/dashboard"
            class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/10 transition
            <%= activePage === 'dashboard'
            ? 'bg-white text-[#014f38] font-semibold'
            : 'hover:bg-white/10 text-white'
        %>">
            <i class="fa-solid fa-chart-line"></i>
            <span>Dashboard</span>
        </a>

        <!-- My Orders -->
        <a href="/customer/orders"
            class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/10 transition">
            <i class="fa-solid fa-bag-shopping"></i>
            <span>My Orders</span>
        </a>

        <!-- Addresses -->
        <a href="/customer/addresses"
            class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/10 transition">
            <i class="fa-solid fa-location-dot"></i>
            <span>Addresses</span>
        </a>

        <!-- Ziggy Points -->
        <a href="/customer/loyalty-points"
            class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/10 transition">
            <i class="fa-solid fa-gift"></i>
            <span>Ziggy Points</span>
        </a>

        <!-- Reviews -->
        <a href="/customer/reviews"
            class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/10 transition">
            <i class="fa-solid fa-star"></i>
            <span>Reviews</span>
        </a>

    </nav>

    <!-- User profile -->
    <div class="mt-auto pt-6 border-t border-white/10">

        <a href="/profile">

            <div class="mb-5 flex items-center gap-3">
    
                <div
                    class="w-12 h-12 rounded-full bg-[#ff7a00] flex items-center justify-center font-bold">
    
                    <img
                        src="https://ui-avatars.com/api/?name=Diya+Vora&background=ff7a00&color=fff&size=256"
                        alt="Profile"
                        class="w-12 h-12 rounded-full border-2 border-white object-cover" id="sidebarProfile">
    
                </div>
    
                <div>
                    <h3 class="font-medium" id="sidebarName">
                        Diya Vora
                    </h3>
    
                    <p class="text-xs text-gray-300" id="sidebarRole">
                        Customer
                    </p>
                </div>
    
            </div>
        </a>

    </div>

</aside>